 \u043c\u0435\u0440\u0435\u0436\u0456. 6. \u0417\u0430\u043c\u0456\u043d\u0438\u0442\u0438 \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0442\u043e\u0440\u0430 \u043d\u0430 Adam \u0442\u0430 \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0437\u043c\u0456\u043d\u0438 \u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0442\u0430 \u0444\u0443\u043d\u043a\u0446\u0456\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435\u0439\u0440\u043e\u043d\u043d\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456. 7. \u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0456\u0457 \u043d\u0435\u0439\u0440\u043e\u043d\u0456\u0432 \u0443 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u043e\u043c\u0443 \u0448\u0430\u0440\u0456 \u0442\u0430 \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0437\u043c\u0456\u043d\u0438 \u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0442\u0430 \u0444\u0443\u043d\u043a\u0446\u0456\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435\u0439\u0440\u043e\u043d\u043d\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456. \u044f \u043c\u0430\u044e \u0432 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0456\u0439 3 \u0432\u0438\u0434\u0438 \u043d\u043c, \u0432\u0438\u0434\u0456\u043b\u0435\u043d\u043d\u044f \u043e\u0437\u043d\u0430\u043a \u0432 \u043c\u0430\u0441\u0438\u0432\u0438 \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0433\u043e\u0442\u043e\u0432\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456 \u0456 \u043a\u043b\u0430\u0441\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044f \u0437\u0430 \u0432\u0438\u0434\u0456\u043b\u0435\u043d\u0438\u043c\u0438 \u043e\u0437\u043d\u0430