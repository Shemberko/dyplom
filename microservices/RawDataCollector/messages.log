40\u0430\u0442\u0438 \u0442\u0430 \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c \u043c\u0435\u0440\u0435\u0436\u0456 \u043d\u0430 \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0438\u0445 \u0442\u0430 \u0442\u0435\u0441\u0442\u043e\u0432\u0438\u0445 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f\u0445, \u0447\u0430\u0441 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u043e\u043a\u0440\u0435\u043c\u0438\u0445 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0456\u0432. 2. \u041d\u0430\u043f\u0438\u0441\u0430\u0442\u0438 \u0441\u043f\u0456\u0432\u0432\u0456\u0434\u043d\u043e\u0448\u0435\u043d\u043d\u044f, \u044f\u043a\u0456 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u044e\u0442\u044c \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0456\u0432 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u043f\u0456\u0441\u043b\u044f \u0437\u0433\u043e\u0440\u0442\u043a\u043e\u0432\u0438\u0445 \u0448\u0430\u0440\u0456\u0432. 3. \u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0437\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u043c\u0435\u043d\u0448\u0435\u043d\u043d\u044f \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0444\u0456\u043b\u044c\u0442\u0440\u0456\u0432 \u0443 \u0437\u0433\u043e\u0440\u0442\u043a\u043e\u0432\u0438\u0445 \u0448\u0430\u0440\u0430\u0445 \u0442\u0430 \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0437\u043c\u0456\u043d\u0438 \u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0442\u0430 \u0444\u0443\u043d\u043a\u0446\u0456\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435\u0439\u0440\u043e\u043d\u043d\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456. 4. \u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0437\u0433\u043e