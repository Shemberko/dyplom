424\u043e\u0441\u0442\u0435\u0440\u041a\u0430\u043b\u0456 \u0420\u0435\u0456\u0441\u041c\u0456\u0448\u0435\u043b\u044c \u041c\u043e\u043d\u0430\u0491\u0430\u043d\u041c\u0430\u0439\u043a\u043b \u041f\u043e\u0442\u0442\u0441 \u0420\u0435\u0436\u0438\u0441\u0435\u0440\u0438\u041a\u0435\u0440\u0456 \u0424\u0443\u043a\u0443\u043d\u0430\u0491\u0430\u0418\u0441\u0430 \u041b\u043e\u043f\u0435\u0437\u0414\u0435\u043d\u0456\u0435\u043b \u0421\u0430\u043a\u0445\u0430\u0439\u043c\u0414\u0436\u043e\u043d \u041a\u0440\u0430\u0443\u043b\u0456 \u0421\u0445\u043e\u0436\u0456 \u0444\u0456\u043b\u044c\u043c\u0438 \u0442\u0430 \u0441\u0435\u0440\u0456\u0430\u043b\u0438 \u0414\u0438\u0432\u043d\u0456 \u0434\u0438\u0432\u0430 2016-2026, \u0421\u0428\u0410, \u0422\u0440\u0438\u043b\u043b\u0435\u0440\u044b \u041d\u043e\u0432\u043e\u0431\u0440\u0430\u043d\u0435\u0446\u044c 2018 - ..., \u0421\u0428\u0410, \u0414\u0440\u0430\u043c\u044b \u0414\u0435\u043a\u0441\u0442\u0435\u0440 / \u041f\u0440\u0430\u0432\u043e\u0441\u0443\u0434\u0438\u0435 \u0414\u0435\u043a\u0441\u0442\u0435\u0440\u0430 2006-2022, \u0421\u0428\u0410, \u0422\u0440\u0438\u043b\u043b\u0435\u0440\u044b \u041c\u0435\u0439\u0440 \u0437 \u0406\u0441\u0442\u0442\u0430\u0443\u043d\u0430 2021, \u0421\u0428\u0410, \u0414\u0440\u0430\u043c\u044b \u041a\u0430\u0441\u043b 2009-2016, \u0421\u0428\u0410, \u041a\u0440\u0438\u043c\u0438\u043d\u0430\u043b \u041a\u0456\u0441\u0442\u043a\u0438 2005-2017, \u0421\u0428\u0410, \u0414\u0440\u0430\u043c\u044b \u0414\u0435\u043a\u0441\u0442\u0435\u0440: \u041f\u0435\u0440\u0432\u043e\u0440\u043e\u0434\u043d\u0438\u0439 \u0433\u0440\u0456\u0445 2024-2025, \u0421\u0428\u0410, \u0414\u0440\u0430\u043c\u044b \u041f\u043e", "title": "\u0414\u0438\u0432\u0438\u0442\u0438\u0441\u044c \u0441\u0435\u0440\u0456\u0430\u043b \u0421\u043f\u0440\u0430\u0432\u0436\u043d\u0456\u0439 \u0434\u0435\u0442\u0435\u043a\u0442\u0438\u0432 2 \u0441\u0435\u0437\u043e\u043d \u0432 \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u0456 \u0456\u0437 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0430\u043c\u0438 \u043e\u043d\u043b\u0430\u0439\u043d \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u043e \u0443 \u0432\u0438\u0441\u043e\u043a\u0456\u0439 \u044f\u043a\u043e\u0441\u0442\u0456", "url": "https://true-detective-ua.net/238-subtitles/2-season", "active": 377875, "totalOpen": 377875}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "", "previewImage": "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1422450/bb234ef2fd0409fffbd0e0d0c470c05167d18535/capsule_616x353.jpg?t=1769127177", "tabId": 1903420215, "textSample": "\u0412\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u0432 \u043d\u0430\u0441\u0442\u0456\u043b\u044c\u043d\u043e\u043c\u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443\u0412\u0438 \u043d\u0435 \u0432\u0432\u0456\u0439\u0448\u043b\u0438!\u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u0446\u044e \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443 \u0432 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443 Steam, \u0449\u043e\u0431 \u0434\u043e\u0434\u0430\u0442\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442 \u0434\u043e \u0441\u043f\u0438\u0441\u043a\u0443 \u0431\u0430\u0436\u0430\u043d\u043e\u0433\u043e, \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u0432\u0430\u0442\u0438 \u0447\u0438 \u043a\u0443\u043f\u0438\u0442\u0438 \u0439\u043e\u0433\u043e, \u0430 \u0442\u0430\u043a\u043e\u0436 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0457 \u0423\u0441\u0456 \u0456\u0433\u0440\u0438 > \u0411\u043e\u0439\u043e\u0432\u0438\u043a\u0438 > Deadlock \u0426\u0435\u043d\u0442\u0440 \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0438 Deadlock Deadlock \u0420\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a Valve \u0412\u0438\u0434\u0430\u0432\u0435\u0446\u044c Valve \u0414\u0430\u0442\u0430 \u0432\u0438\u0445\u043e\u0434\u0443 \u0411\u0443\u0434\u0435 \u043e\u0433\u043e\u043b\u043e\u0448\u0435\u043d\u043e \u043f\u0456\u0437\u043d\u0456\u0448\u0435 Deadlock \u2014 \u0446\u0435 \u0431\u0430\u0433\u0430\u0442\u043e\u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u0430 \u0433\u0440\u0430 \u043d\u0430 \u0440\u0430\u043d\u043d\u044c\u043e\u043c\u0443 \u0435\u0442\u0430\u043f\u0456 \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438. \u0423\u0441\u0456 \u0440\u0435\u0446\u0435\u043d\u0437\u0456\u0457: \u041d\u0435\u043c\u0430\u0454 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u0438\u0445 \u0440\u0435\u0446\u0435\u043d\u0437\u0456\u0439 \u0414\u0430\u0442\u0430 \u0432\u0438\u0445\u043e\u0434\u0443: \u0411\u0443\u0434\u0435 \u043e\u0433\u043e\u043b\u043e\u0448\u0435\u043d\u043e \u043f\u0456\u0437\u043d\u0456\u0448\u0435 \u0420\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a: Valve \u0412\u0438\u0434\u0430\u0432\u0435\u0446\u044c: Valve \u041f\u043e\u0437\u043d\u0430\u0447\u043a\u0438 \u041f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u0456 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u0456 \u043f\u043e\u0437\u043d\u0430\u0447\u043a\u0438 \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0443: \u041c\u041e\u0411\u0410 \u0421\u0442\u0440\u0456\u043b\u044f\u043d\u043a\u0430 \u0432\u0456\u0434 \u0442\u0440\u0435\u0442\u044c\u043e\u0457 \u043e\u0441\u043e\u0431\u0438 \u0411\u0430\u0433\u0430\u0442\u043e\u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u0430 \u0433\u0440\u0430 \u0413\u0435\u0440\u043e\u0439\u0441\u044c\u043a\u0430 \u0441\u0442\u0440\u0456\u043b\u044f\u043d\u043a\u0430 \u041a\u043e\u043c\u0430\u043d\u0434\u043d\u0430 \u0433\u0440\u0430 \u0417\u043c\u0430\u0433\u0430\u043d\u043d\u044f \u0421\u0442\u0440\u0456\u043b\u044f\u043d\u043a\u0430 \u0412\u0456\u0434 \u0442\u0440\u0435\u0442\u044c\u043e\u0457 \u043e\u0441\u043e\u0431\u0438 \u0411\u043e\u0439\u043e\u0432\u0438\u043a \u0414\u043e\u0447\u0430\u0441\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u0413\u0440\u0430\u0432\u0435\u0446\u044c \u043f\u0440\u043e\u0442\u0438 \u0433\u0440\u0430\u0432\u0446\u044f \u0412\u0456\u043b\u044c\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u041c\u0435\u0440\u0435\u0436\u0435\u0432\u0438\u0439 \u043a\u043e\u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432 \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044f \u0422\u0430\u043a\u0442\u0438\u043a\u0430 \u041a\u043e\u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432 \u0412\u0435\u0441\u0435\u043b\u043e \u0414\u043b\u044f \u0434\u043e\u0440\u043e\u0441\u043b\u0438\u0445 \u0421\u0435\u043a\u0441\u0443\u0430\u043b\u044c\u043d\u0438\u0439 \u0432\u043c\u0456\u0441\u0442 \u041c\u0438\u043b\u043e\u0432\u0438\u0434\u043d\u043e + \u0420\u0435\u0446\u0435\u043d\u0437\u0456\u0457 \u0423\u0441\u0456 \u0440\u0435\u0446\u0435\u043d\u0437\u0456\u0457: \u041d\u0435\u043c\u0430\u0454 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u0438\u0445 \u0440\u0435\u0446\u0435\u043d\u0437\u0456\u0439 \u0423\u0432\u0456\u0439\u0434\u0456\u0442\u044c \u0434\u043e \u0430\u043a\u0430\u0443\u043d\u0442\u0430, \u0449\u043e\u0431\u0438 \u0434\u043e\u0434\u0430\u0442\u0438 \u0446\u0435\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442 \u0434\u043e \u0441\u043f\u0438\u0441\u043a\u0443 \u0431\u0430\u0436\u0430\u043d\u043e\u0433\u043e \u0447\u0438 \u043f\u043e\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u044f\u043a \u0456\u0433\u043d\u043e\u0440\u043e\u0432\u0430\u043d\u0438\u0439. \u041f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0439 \u0432\u0456\u0434\u043e\u043c\u043e\u0441\u0442\u0456 \u0427\u0418\u0422\u0410\u0422\u0418 \u0414\u0410\u041b\u0406 \u041e\u0441\u043e\u0431\u043b\u0438\u0432\u043e\u0441\u0442\u0456 \u041c\u043e\u0432\u0438: \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0430 \u0456 \u0449\u0435 16 \u0422\u0435\u043a\u0441\u0442 \u0417\u0432\u0443\u043a \u0421\u0443\u0431\u0442. \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0430 \u2714 \u0430\u043d\u0433\u043b\u0456\u0439\u0441\u044c\u043a\u0430 \u2714 \u2714 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u044c\u043a\u0430 \u2714 \u0456\u0441\u043f\u0430\u043d\u0441\u044c\u043a\u0430 (\u0406\u0441\u043f\u0430\u043d\u0456\u044f) \u2714 \u0447\u0435\u0441\u044c\u043a\u0430 \u2714 \u043f\u043e\u0440\u0442\u0443\u0433\u0430\u043b\u044c\u0441\u044c\u043a\u0430 (\u0411\u0440\u0430\u0437\u0438\u043b\u0456\u044f) \u2714 \u0440\u043e\u0441\u0456\u0439\u0441\u044c\u043a\u0430 \u2714 \u043a\u0438\u0442\u0430\u0439\u0441\u044c\u043a\u0430 (\u0441\u043f\u0440\u043e\u0449\u0435\u043d\u0430) \u2714 \u0442\u0443\u0440\u0435\u0446\u044c\u043a\u0430 \u2714 \u0456\u0441\u043f\u0430\u043d\u0441\u044c\u043a\u0430 (\u041b\u0430\u0442\u0438\u043d\u0441\u044c\u043a\u0430 \u0410\u043c\u0435\u0440\u0438\u043a\u0430) \u2714 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u0430 \u2714 \u043a\u043e\u0440\u0435\u0439\u0441\u044c\u043a\u0430 \u2714 \u043f\u043e\u043b\u044c\u0441\u044c\u043a\u0430 \u2714 \u0456\u0442\u0430\u043b\u0456\u0439\u0441\u044c\u043a\u0430 \u2714 \u0456\u043d\u0434\u043e\u043d\u0435\u0437\u0456\u0439\u0441\u044c\u043a\u0430 \u2714 \u0442\u0430\u0439\u0441\u044c\u043a\u0430 \u2714 \u044f\u043f\u043e\u043d\u0441\u044c\u043a\u0430 \u2714 \u0414\u0438\u0432. \u0443\u0441\u0456 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0456 \u043c\u043e\u0432\u0438: 17 \u0412\u043c\u0456\u0441\u0442 \u041c\u0456\u0441\u0442\u0438\u0442\u044c \u0456\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u043d\u0456 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438 \u0412\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u044f \u0432 \u043c\u0435\u0440\u0435\u0436\u0456, \u0412\u043d\u0443\u0442\u0440\u0456\u0448\u043d\u044c\u043e\u0456\u0433\u0440\u043e\u0432\u0438\u0439 \u0447\u0430\u0442 \u041d\u0430\u0437\u0432\u0430: Deadlock \u0416\u0430\u043d\u0440: \u0411\u043e\u0439\u043e\u0432\u0438\u043a\u0438 \u0420\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a: Valve \u0412\u0438\u0434\u0430\u0432\u0435\u0446\u044c: Valve \u0414\u0430\u0442\u0430 \u0432\u0438\u0445\u043e\u0434\u0443: \u0411\u0443\u0434\u0435 \u043e\u0433\u043e\u043b\u043e\u0448\u0435\u043d\u043e \u043f\u0456\u0437\u043d\u0456\u0448\u0435 \u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0456\u0441\u0442\u043e\u0440\u0456\u044e \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u044c \u0427\u0438\u0442\u0430\u0442\u0438 \u043f\u043e\u0432\u2019\u044f\u0437\u0430\u043d\u0456 \u043d\u043e\u0432\u0438\u043d\u0438 \u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u0434\u043e \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u0435\u043d\u044c \u0417\u043d\u0430\u0439\u0442\u0438 \u0433\u0440\u0443\u043f\u0438 \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0438 \u0412\u0441\u0442\u0430\u0432\u043a\u0430 \u0423\u0432\u0430\u0433\u0430: Deadlock \u043f\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0454 \u043d\u0430 \u0440\u0430\u043d\u043d\u044c\u043e\u043c\u0443 \u0435\u0442\u0430\u043f\u0456 \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u0439 \u043c\u0430\u0454 \u0431\u0435\u0437\u043b\u0456\u0447 \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u0438\u0445 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u044c \u0442\u0430 \u0435\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0438\u0445 \u0456\u0433\u0440\u043e\u043b\u0430\u0434\u043d\u0438\u0445 \u043c\u0435\u0445\u0430\u043d\u0456\u043a. \u0414\u043e\u0441\u0442\u0443\u043f \u043d\u0430\u0440\u0430\u0437\u0456 \u043c\u0430\u044e\u0442\u044c \u043b\u0438\u0448\u0435 \u043d\u0430\u0448\u0456 \u0442\u0435\u0441\u0442\u0443\u0432\u0430\u043b\u044c\u043d\u0438\u043a\u0438 \u0442\u0430 \u0437\u0430\u043f\u0440\u043e\u0448\u0435\u043d\u0456 \u043d\u0438\u043c\u0438 \u0434\u0440\u0443\u0437\u0456. \u0426\u044f \u0433\u0440\u0430 \u0449\u0435 \u043d\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0443 Steam \u0417\u0430\u043f\u043b\u0430\u043d\u043e\u0432\u0430\u043d\u0430 \u0434\u0430\u0442\u0430 \u0432\u0438\u043f\u0443\u0441\u043a\u0443: \u0411\u0443\u0434\u0435 \u043e\u0433\u043e\u043b\u043e\u0448\u0435\u043d\u043e \u043f\u0456\u0437\u043d\u0456\u0448\u0435 \u0417\u0430\u0446