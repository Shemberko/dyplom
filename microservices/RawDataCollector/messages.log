\u0435\u043d\u0442\u0438\n2.5 Flash\n\nGemini \u043c\u043e\u0436\u0435 \u043f\u043e\u043c\u0438\u043b\u044f\u0442\u0438\u0441\u044f, \u0442\u043e\u043c\u0443 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u043c\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0442\u0438 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456.", "title": "Google Gemini", "url": "https://gemini.google.com/app/6db50c602c117e1a", "active": 0, "totalOpen": 119994}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0454\u043c\u043e Gemini, \u043f\u043e\u043c\u0456\u0447\u043d\u0438\u043a\u0430 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u0428\u0406 \u0432\u0456\u0434 Google. \u0428\u0406 \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u043d\u0430\u0432\u0447\u0430\u0442\u0438\u0441\u044f, \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u0442\u0438, \u043e\u0431\u0433\u043e\u0432\u043e\u0440\u044e\u0432\u0430\u0442\u0438 \u0456\u0434\u0435\u0457 \u0456 \u0431\u0430\u0433\u0430\u0442\u043e \u0456\u043d\u0448\u043e\u0433\u043e. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0432\u0441\u0456 \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0438 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0428\u0406.", "tabId": "1903317173", "textSample": "Gemini\nPRO\n\u041f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u044f \u043f\u0430\u0440\u0441\u0438\u043d\u0433\u0443 \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0443 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438\n\u0410\u0432\u0442\u043e \u0434\u043e 5000 \u0434\u043e\u043b\u0430\u0440\u0456\u0432: \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0457\n\u041a\u043b\u0430\u0441\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044f \u0442\u0435\u043a\u0441\u0442\u0443 \u0437 Keras Embedding\nVisual Prolog: \u0414\u0438\u043d\u0430\u043c\u0456\u0447\u043d\u0430 \u0411\u0430\u0437\u0430 \u0414\u0430\u043d\u0438\u0445 \u0421\u0456\u043c'\u0457\n**\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0435 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f** 1. \u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0432 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0456 Google Colab \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0443 \u0431\u0430\u0437\u043e\u0432\u0443 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443 \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u044c \u043e\u0431\u2019\u0454\u043a\u0442\u0456\u0432 \u0434\u0432\u043e\u0445 \u043a\u043b\u0430\u0441\u0456\u0432 \u043f\u0440\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u0456 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u043d\u0430\u0432\u0447\u0435\u043d\u043e\u0457 \u0437\u0433\u043e\u0440\u0442\u043a\u043e\u0432\u043e\u0457 \u043d\u0435\u0439\u0440\u043e\u043d\u043d\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456 VGG16. \u0417\u0430\u0444\u0456\u043a\u0441\u0443\u0432\u0430\u0442\u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438: \u0432\u0442\u0440\u0430\u0442\u0438 \u0442\u0430 \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c \u043c\u0435\u0440\u0435\u0436\u0456 \u043d\u0430 \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u0438\u0445 \u0442\u0430 \u0442\u0435\u0441\u0442\u043e\u0432\u0438\u0445 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f\u0445, \u0447\u0430\u0441 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u043e\u043a\u0440\u0435\u043c\u0438\u0445 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0456\u0432. 2. \u041d\u0430\u043f\u0438\u0441\u0430\u0442\u0438 \u0441\u043f\u0456\u0432\u0432\u0456\u0434\u043d\u043e\u0448\u0435\u043d\u043d\u044f, \u044f\u043a\u0456 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u044e\u0442\u044c \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0456\u0432 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u043f\u0456\u0441\u043b\u044f \u0437\u0433\u043e\u0440\u0442\u043a\u043e\u0432\u0438\u0445 \u0448\u0430\u0440\u0456\u0432. 3. \u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0437\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u043c\u0435\u043d\u0448\u0435\u043d\u043d\u044f \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0444\u0456\u043b\u044c\u0442\u0440\u0456\u0432 \u0443 \u0437\u0433\u043e\u0440\u0442\u043a\u043e\u0432\u0438\u0445 \u0448\u0430\u0440\u0430\u0445 \u0442\u0430 \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0437\u043c\u0456\u043d\u0438 \u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0442\u0430 \u0444\u0443\u043d\u043a\u0446\u0456\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435\u0439\u0440\u043e\u043d\u043d\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456. 4. \u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0437\u0433\u043e\u0440\u0442\u043a\u043e\u0432\u0438\u0445 \u0448\u0430\u0440\u0456\u0432 \u0442\u0430 \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0437\u043c\u0456\u043d\u0438 \u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0442\u0430 \u0444\u0443\u043d\u043a\u0446\u0456\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435\u0439\u0440\u043e\u043d\u043d\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456. 5. \u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043f\u043e\u0432\u043d\u043e\u0437\u0432\u2019\u044f\u0437\u043d\u0438\u0445 \u0448\u0430\u0440\u0456\u0432 \u043d\u0435\u0439\u0440\u043e\u043d\u0456\u0432 \u0442\u0430 \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0437\u043c\u0456\u043d\u0438 \u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0442\u0430 \u0444\u0443\u043d\u043a\u0446\u0456\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435\u0439\u0440\u043e\u043d\u043d\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456. 6. \u0417\u0430\u043c\u0456\u043d\u0438\u0442\u0438 \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0442\u043e\u0440\u0430 \u043d\u0430 Adam \u0442\u0430 \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0437\u043c\u0456\u043d\u0438 \u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0442\u0430 \u0444\u0443\u043d\u043a\u0446\u0456\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435\u0439\u0440\u043e\u043d\u043d\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456. 7. \u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0456\u0457 \u043d\u0435\u0439\u0440\u043e\u043d\u0456\u0432 \u0443 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u043e\u043c\u0443 \u0448\u0430\u0440\u0456 \u0442\u0430 \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0437\u043c\u0456\u043d\u0438 \u0443 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f \u0442\u0430 \u0444\u0443\u043d\u043a\u0446\u0456\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435\u0439\u0440\u043e\u043d\u043d\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456. \u044f \u043c\u0430\u044e \u0432 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0456\u0439 3 \u0432\u0438\u0434\u0438 \u043d\u043c, \u0432\u0438\u0434\u0456\u043b\u0435\u043d\u043d\u044f \u043e\u0437\u043d\u0430\u043a \u0432 \u043c\u0430\u0441\u0438\u0432\u0438 \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0433\u043e\u0442\u043e\u0432\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456 \u0456 \u043a\u043b\u0430\u0441\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044f \u0437\u0430 \u0432\u0438\u0434\u0456\u043b\u0435\u043d\u0438\u043c\u0438 \u043e\u0437\u043d\u0430\u043a\u0430\u043c\u0438 \u043a\u043e\u043c\u0431\u0456\u043d\u043e\u0432\u0430\u043d\u0430 \u043c\u0435\u0440\u0435\u0436\u0430 \u044f\u043a\u0456 \u043c\u0456\u0441\u0442\u0438\u0442\u044c \u0432 \u0441\u043e\u0431\u0456 \u0433\u043e\u0442\u043e\u0432\u0443 \u0456 \u043a\u043e\u043c\u0431\u0456\u043d\u043e\u0432\u0430\u043d\u0430 \u043c\u0435\u0440\u0435\u0436\u0430 \u0437 Fine-Tuning \u044f \u043f\u043e\u0432\u0438\u043d\u0435\u043d \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0437\u043c\u0456\u043d\u0438 \u0432\u043a\u0430\u0437\u0430\u043d\u0456 \u0432 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u0456 \u0434\u043e Fine-Tuning?\nMercury: \u0420\u043e\u0434\u0438\u043d\u043d\u0456 \u0417\u0432'\u044f\u0437\u043a\u0438 \"\u0413\u0440\u0438 \u041f\u0440\u0435\u0441\u0442\u043e\u043b\u0456\u0432\"\nIDE Plugin Incompatibility and Resolution\nWSL \u0442\u0430 \u043f\u043b\u0430\u0433\u0456\u043d\u0438 IDE: \u043f\u043e\u043c\u0438\u043b\u043a\u0438\n\u042f\u043a \u0437\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u0438 \u0434\u0438\u0437\u0435\u043b\u044c \u043d\u0430 \u0410\u0417\u0421\n\u041d\u043e\u0440\u043c\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f URL \u0434\u043b\u044f \u0443\u043d\u0438\u043a\u043d\u0435\u043d\u043d\u044f \u0434\u0443\u0431\u043b\u0456\u043a\u0430\u0442\u0456\u0432\nNeo4j Python Helper Class Explanation\n\u0424\u0443\u043d\u043a\u0446\u0456\u043e\u043d\u0430\u043b\u044c\u043d\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u0432 Racket\n\u0420\u043e\u0437\u0440\u043e\u0431\u043a\u0430 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u043e\u0457 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 Google\n\u0420\u043e\u0437\u043c\u043e\u0432\u0430 \u0437 Gemini\n\n\u044f\u043a \u043e\u0431\u0440\u0430\u0442\u0438 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0442\u0438\u043f\u0443 Page ?\n\n\n\n\n\u0406\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438\n2.5 Flash\n\nGemini \u043c\u043e\u0436\u0435 \u043f\u043e\u043c\u0438\u043b\u044f\u0442\u0438\u0441\u044f, \u0442\u043e\u043c\u0443 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u043c\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0442\u0438 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456.", "title": "Google Gemini", "url": "https://gemini.google.com/app/6db50c602c117e1a", "active": 0, "totalOpen": 120016}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "This chapter provides instructions for installation and basic usage of the Neo4j Graph Data Science library.", "tabId": "1903319970", "textSample": "Neo4j Graph Data Science\nInstallation\nRaise an issue\nInstallation\n\nThe Neo4j Graph Data Science (GDS) library is delivered as a plugin to the Neo4j Graph Database. The plugin needs to be installed into the database and configured.\n\nAura Graph Analytics is the new fully managed, on-demand analytics-as-a-service offering in Neo4j Aura.\n\nNeo4j Data Science Sandbox is a free, cloud-based instance of Neo4j with GDS Community Edition preinstalled.\n\nNeo4j AuraDS is the fully managed version of Neo4j GDS Enterprise Edition which does not require any installation.\n\nInstallation methods\n\nYou can install the GDS library in different ways depending on your Neo4j deployment.\n\nIf you are new to Neo4j, a convenient option to get started is to install the Neo4j Desktop application first. On Neo4j Desktop you can install the GDS library directly from the UI.\n\nIf you use any edition of the Neo4j Server (Community or Enterprise), you need to install the GDS library manually as explained in the Neo4j Server section.\n\nIf you run Neo4j in a Docker container, you need to configure the GDS library as a Neo4j Docker plugin.\n\nIf you run Neo4j in a cluster, you can follow the same instructions for the Neo4j Server with some additional considerations.\n\nIf you run Neo4j in a Kubernetes cluster, you can add GDS to the Neo4j Helm chart deployments.\n\nGDS Enterprise Edition\n\nThe Enterprise Edition (EE) of the library requires a license key as well. You can find more details on requesting and configuring a license key in the GDS Enterprise Edition section.\n\nGDS EE includes Apache Arrow for advanced graph import and export capabilities. Arrow can be enabled and configured as detailed in the Apache Arrow guide.\n\nGDS as a service\n\nYou can run GDS as a service using Aura Graph Analytics. This option does not require any installation and gives access to the enterprise features without needing a license.\n\nVerifying the installation\n\nTo verify your installation, run the gds.version() function in the Neo4j Browser:\n\nRETURN gds.version();\n\nTo list all available procedures, call the gds.list() procedure:\n\nCALL gds.list();\n\nIf you have installed GDS EE, call the gds.isLicensed() function and check that the returned value is true:\n\nRETURN gds.isLicensed();\n\nFor more details, you can call the gds.license.state() procedure:\n\nCALL gds.license.state();\nAdditional configuration\n\nIn order to make use of certain features of the GDS library, additional configuration may be necessary. For example, exporting graphs to CSV files requires the configuration parameter gds.export.location to be set to the folder in which exported graphs are to be stored.\n\nYou can find the list of all the configuration options here. Refer to the installation methods for details on how to edit a Neo4j database configuration depending on the Neo4j deployment.\n\nGraph Data Science on MacOS\n\nIf you are running MacOS (x86 or ARM), it is currently required to add the following configuration entry to neo4j.conf:\n\nserver.jvm.additional=-Djol.skipHotspotSAAttach=true\nReference\n\nSupported Neo4j versions\n\nSystem Requirements\n\nIntroduction\nSupported Neo4j versions\nContents\nInstallation methods\nGDS as a service\nVerifying the installation\nAdditional configuration\nGraph Data Science on MacOS\nReference\nGraph Data Science courses on GraphAcademy\n\nFollow our Graph Data Analytics learning path to learn how to apply graph thinking to your machine learning pipelines.\n\nEnroll now", "title": "Installation - Neo4j Graph Data Science", "url": "https://neo4j.com/docs/graph-data-science/current/installation/", "active": 68293, "totalOpen": 365617}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "This chapter provides instructions for installation and basic usage of the Neo4j Graph Data Science library.", "tabId": "1903319970", "textSample": "Neo4j Graph Data Science\nInstallation\nRaise an issue\nInstallation\n\nThe Neo4j Graph Data Science (GDS) library is delivered as a plugin to the Neo4j Graph Database. The plugin needs to be installed into the database and configured.\n\nAura Graph Analytics is the new fully managed, on-demand analytics-as-a-service offering in Neo4j Aura.\n\nNeo4j Data Science Sandbox is a free, cloud-based instance of Neo4j with GDS Community Edition preinstalled.\n\nNeo4j AuraDS is the fully managed version of Neo4j GDS Enterprise Edition which does not require any installation.\n\nInstallation methods\n\nYou can install the GDS library in different ways depending on your Neo4j deployment.\n\nIf you are new to Neo4j, a convenient option to get started is to install the Neo4j Desktop application first. On Neo4j Desktop you can install the GDS library directly from the UI.\n\nIf you use any edition of the Neo4j Server (Community or Enterprise), you need to install the GDS library manually as explained in the Neo4j Server section.\n\nIf you run Neo4j in a Docker container, you need to configure the GDS library as a Neo4j Docker plugin.\n\nIf you run Neo4j in a cluster, you can follow the same instructions for the Neo4j Server with some additional considerations.\n\nIf you run Neo4j in a Kubernetes cluster, you can add GDS to the Neo4j Helm chart deployments.\n\nGDS Enterprise Edition\n\nThe Enterprise Edition (EE) of the library requires a license key as well. You can find more details on requesting and configuring a license key in the GDS Enterprise Edition section.\n\nGDS EE includes Apache Arrow for advanced graph import and export capabilities. Arrow can be enabled and configured as detailed in the Apache Arrow guide.\n\nGDS as a service\n\nYou can run GDS as a service using Aura Graph Analytics. This option does not require any installation and gives access to the enterprise features without needing a license.\n\nVerifying the installation\n\nTo verify your installation, run the gds.version() function in the Neo4j Browser:\n\nRETURN gds.version();\n\nTo list all available procedures, call the gds.list() procedure:\n\nCALL gds.list();\n\nIf you have installed GDS EE, call the gds.isLicensed() function and check that the returned value is true:\n\nRETURN gds.isLicensed();\n\nFor more details, you can call the gds.license.state() procedure:\n\nCALL gds.license.state();\nAdditional configuration\n\nIn order to make use of certain features of the GDS library, additional configuration may be necessary. For example, exporting graphs to CSV files requires the configuration parameter gds.export.location to be set to the folder in which exported graphs are to be stored.\n\nYou can find the list of all the configuration options here. Refer to the installation methods for details on how to edit a Neo4j database configuration depending on the Neo4j deployment.\n\nGraph Data Science on MacOS\n\nIf you are running MacOS (x86 or ARM), it is currently required to add the following configuration entry to neo4j.conf:\n\nserver.jvm.additional=-Djol.skipHotspotSAAttach=true\nReference\n\nSupported Neo4j versions\n\nSystem Requirements\n\nIntroduction\nSupported Neo4j versions\nContents\nInstallation methods\nGDS as a service\nVerifying the installation\nAdditional configuration\nGraph Data Science on MacOS\nReference\nGraph Data Science courses on GraphAcademy\n\nFollow our Graph Data Analytics learning path to learn how to apply graph thinking to your machine learning pipelines.\n\nEnroll now", "title": "Installation - Neo4j Graph Data Science", "url": "https://neo4j.com/docs/graph-data-science/current/installation/", "active": 0, "totalOpen": 119988}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "", "tabId": "1903319980", "textSample": "\u0412 \u0446\u044c\u043e\u043c\u0443 \u0432\u0438\u043f\u0430\u0434\u043a\u0443 \u043c\u0438 \u0432\u0437\u044f\u043b\u0438 \u043f\u043e\u0442\u0440\u043e\u0445\u0438 \u0437 \u043a\u043e\u0436\u043d\u043e\u0457 \u0441\u0435\u043a\u0446\u0456\u0457, \u0430 \u0441\u0442\u0440\u0456\u0447\u043a\u0438 <<<<<<<, ======= \u0442\u0430 >>>>>>> \u0432\u0438\u0434\u0430\u043b\u0438\u043b\u0438 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e. \u041f\u0456\u0441\u043b\u044f \u0442\u043e\u0433\u043e, \u044f\u043a \u0432\u0438 \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043b\u0438 \u043f\u043e\u0434\u0456\u0431\u043d\u0456 \u043d\u0435\u0441\u0443\u043c\u0456\u0441\u043d\u043e\u0441\u0442\u0456 \u0432 \u043a\u043e\u0436\u043d\u043e\u043c\u0443 \u0431\u043b\u043e\u0446\u0456 \u043a\u043e\u043d\u0444\u043b\u0456\u043a\u0442\u043d\u0438\u0445 \u0444\u0430\u0439\u043b\u0456\u0432, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0434\u043b\u044f \u043d\u0438\u0445 git add, \u0449\u043e\u0431 \u0456\u043d\u0434\u0435\u043a\u0441\u0443\u0432\u0430\u0442\u0438 \u0442\u0430 \u043f\u043e\u0437\u043d\u0430\u0447\u0438\u0442\u0438, \u044f\u043a \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u0456. \u0406\u043d\u0434\u0435\u043a\u0441\u0443\u044e\u0447\u0438 \u0444\u0430\u0439\u043b, \u0432\u0438 \u043f\u043e\u0437\u043d\u0430\u0447\u0430\u0454\u0442\u0435 \u0439\u043e\u0433\u043e \u0434\u043b\u044f Git \u0442\u0430\u043a\u0438\u043c, \u0449\u043e \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u043c\u0430\u0454 \u043a\u043e\u043d\u0444\u043b\u0456\u043a\u0442\u0443. \u042f\u043a\u0449\u043e \u0432\u0438 \u0445\u043e\u0447\u0435\u0442\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0438\u0439 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u043d\u044f \u043a\u043e\u043d\u0444\u043b\u0456\u043a\u0442\u0456\u0432, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u043a\u043e\u043c\u0430\u043d\u0434\u0443 git mergetool, \u044f\u043a\u0430 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0438\u0439 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u0442\u0430 \u043f\u0440\u043e\u0432\u0435\u0434\u0435 \u0432\u0430\u0441 \u043f\u043e \u0432\u0441\u044c\u043e\u043c\u0443 \u043f\u0440\u043e\u0446\u0435\u0441\u0443:", "title": "Git - \u041e\u0441\u043d\u043e\u0432\u0438 \u0433\u0430\u043b\u0443\u0436\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f", "url": "https://git-scm.com/book/uk/v2/%D0%93%D0%B0%D0%BB%D1%83%D0%B6%D0%B5%D0%BD%D0%BD%D1%8F-%D0%B2-git-%D0%9E%D1%81%D0%BD%D0%BE%D0%B2%D0%B8-%D0%B3%D0%B0%D0%BB%D1%83%D0%B6%D0%B5%D0%BD%D0%BD%D1%8F-%D1%82%D0%B0-%D0%B7%D0%BB%D0%B8%D0%B2%D0%B0%D0%BD%D0%BD%D1%8F", "active": 54830, "totalOpen": 54830}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "", "tabId": "1903319980", "textSample": "\u0412 \u0446\u044c\u043e\u043c\u0443 \u0432\u0438\u043f\u0430\u0434\u043a\u0443 \u043c\u0438 \u0432\u0437\u044f\u043b\u0438 \u043f\u043e\u0442\u0440\u043e\u0445\u0438 \u0437 \u043a\u043e\u0436\u043d\u043e\u0457 \u0441\u0435\u043a\u0446\u0456\u0457, \u0430 \u0441\u0442\u0440\u0456\u0447\u043a\u0438 <<<<<<<, ======= \u0442\u0430 >>>>>>> \u0432\u0438\u0434\u0430\u043b\u0438\u043b\u0438 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e. \u041f\u0456\u0441\u043b\u044f \u0442\u043e\u0433\u043e, \u044f\u043a \u0432\u0438 \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043b\u0438 \u043f\u043e\u0434\u0456\u0431\u043d\u0456 \u043d\u0435\u0441\u0443\u043c\u0456\u0441\u043d\u043e\u0441\u0442\u0456 \u0432 \u043a\u043e\u0436\u043d\u043e\u043c\u0443 \u0431\u043b\u043e\u0446\u0456 \u043a\u043e\u043d\u0444\u043b\u0456\u043a\u0442\u043d\u0438\u0445 \u0444\u0430\u0439\u043b\u0456\u0432, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0434\u043b\u044f \u043d\u0438\u0445 git add, \u0449\u043e\u0431 \u0456\u043d\u0434\u0435\u043a\u0441\u0443\u0432\u0430\u0442\u0438 \u0442\u0430 \u043f\u043e\u0437\u043d\u0430\u0447\u0438\u0442\u0438, \u044f\u043a \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u0456. \u0406\u043d\u0434\u0435\u043a\u0441\u0443\u044e\u0447\u0438 \u0444\u0430\u0439\u043b, \u0432\u0438 \u043f\u043e\u0437\u043d\u0430\u0447\u0430\u0454\u0442\u0435 \u0439\u043e\u0433\u043e \u0434\u043b\u044f Git \u0442\u0430\u043a\u0438\u043c, \u0449\u043e \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u043c\u0430\u0454 \u043a\u043e\u043d\u0444\u043b\u0456\u043a\u0442\u0443. \u042f\u043a\u0449\u043e \u0432\u0438 \u0445\u043e\u0447\u0435\u0442\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0438\u0439 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u043d\u044f \u043a\u043e\u043d\u0444\u043b\u0456\u043a\u0442\u0456\u0432, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u043a\u043e\u043c\u0430\u043d\u0434\u0443 git mergetool, \u044f\u043a\u0430 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0438\u0439 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u0442\u0430 \u043f\u0440\u043e\u0432\u0435\u0434\u0435 \u0432\u0430\u0441 \u043f\u043e \u0432\u0441\u044c\u043e\u043c\u0443 \u043f\u0440\u043e\u0446\u0435\u0441\u0443:", "title": "Git - \u041e\u0441\u043d\u043e\u0432\u0438 \u0433\u0430\u043b\u0443\u0436\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f", "url": "https://git-scm.com/book/uk/v2/%D0%93%D0%B0%D0%BB%D1%83%D0%B6%D0%B5%D0%BD%D0%BD%D1%8F-%D0%B2-git-%D0%9E%D1%81%D0%BD%D0%BE%D0%B2%D0%B8-%D0%B3%D0%B0%D0%BB%D1%83%D0%B6%D0%B5%D0%BD%D0%BD%D1%8F-%D1%82%D0%B0-%D0%B7%D0%BB%D0%B8%D0%B2%D0%B0%D0%BD%D0%BD%D1%8F", "active": 119986, "totalOpen": 119986}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0414\u0438\u0432\u0456\u0442\u044c\u0441\u044f \u0432\u0456\u0434\u0435\u043e, \u0441\u043b\u0443\u0445\u0430\u0439\u0442\u0435 \u0443\u043b\u044e\u0431\u043b\u0435\u043d\u0443 \u043c\u0443\u0437\u0438\u043a\u0443, \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0439\u0442\u0435 \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442 \u0456 \u0434\u0456\u043b\u0456\u0442\u044c\u0441\u044f \u0432\u0441\u0456\u043c \u0446\u0438\u043c \u0456\u0437 \u0434\u0440\u0443\u0437\u044f\u043c\u0438, \u0441\u0456\u043c'\u0454\u044e \u0439 \u0446\u0456\u043b\u0438\u043c \u0441\u0432\u0456\u0442\u043e\u043c \u043d\u0430 YouTube.", "tabId": "1903319977", "textSample": "", "title": "LIVE | \u0428\u0442\u0443\u0440\u043c - \u0413\u0430\u043b\u0438\u0446\u044c\u043a\u0430 \u0421\u0432\u0456\u0436\u0438\u043d\u0430 I 4 \u0442\u0443\u0440. Elite Business League - YouTube", "url": "https://www.youtube.com/watch?v=YQ6OVEwP1s4", "active": 86408, "totalOpen": 86408}}]}
