440\u043d.\n\u0426\u0456\u043d\u0430 \u0437 \u041f\u0414\u0412\n\u041c\u043e\u0436\u043b\u0438\u0432\u0438\u0439 \u0442\u043e\u0440\u0433\n\u041e\u0431\u043c\u0456\u043d \u043d\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c\n\u0421\u0442\u0430\u043d\n\u0423\u0447\u0430\u0441\u0442\u044c \u0432 \u0414\u0422\u041f\n\u0412\u0441\u0456\n\u041d\u0435 \u0431\u0443\u0432 \u0443 \u0414\u0422\u041f\n\u0411\u0443\u0432 \u0443 \u0414\u0422\u041f\n\u0422\u0435\u0445\u043d\u0456\u0447\u043d\u0438\u0439 \u0441\u0442\u0430\u043d\n\u041b\u0430\u043a\u043e\u0444\u0430\u0440\u0431\u043e\u0432\u0435 \u043f\u043e\u043a\u0440\u0438\u0442\u0442\u044f\n\u0413\u0430\u0440\u0430\u0436\u043d\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043d\u043d\u044f\n\u0421\u0435\u0440\u0432\u0456\u0441\u043d\u0430 \u043a\u043d\u0438\u0436\u043a\u0430\n\u0422\u0435\u0445\u043d\u0456\u0447\u043d\u0456 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438\n\u0422\u0438\u043f \u043f\u0430\u043b\u044c\u043d\u043e\u0433\u043e\n\u0411\u0435\u043d\u0437\u0438\u043d\n\u0414\u0438\u0437\u0435\u043b\u044c\n\u0415\u043b\u0435\u043a\u0442\u0440\u043e\n\u0413\u0430\u0437\n\u0413\u0430\u0437 \u043f\u0440\u043e\u043f\u0430\u043d-\u0431\u0443\u0442\u0430\u043d / \u0411\u0435\u043d\u0437\u0438\u043d\n\u0413\u0430\u0437 \u043c\u0435\u0442\u0430\u043d / \u0411\u0435\u043d\u0437\u0438\u043d\n\u0413\u0456\u0431\u0440\u0438\u0434 (HEV)\n\u0413\u0456\u0431\u0440\u0438\u0434 (PHEV)\n\u0413\u0456\u0431\u0440\u0438\u0434 (MHEV)\n\u041a\u043e\u0440\u043e\u0431\u043a\u0430 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0410\u0432\u0442\u043e\u043c\u0430\u0442\n\u0422\u0438\u043f\u0442\u0440\u043e\u043d\u0456\u043a\n\u0420\u043e\u0431\u043e\u0442\n\u0412\u0430\u0440\u0456\u0430\u0442\u043e\u0440\n\u0420\u0435\u0434\u0443\u043a\u0442\u043e\u0440\n\u041f\u0440\u043e\u0431\u0456\u0433, \u0442\u0438\u0441. \u043a\u043c\n\u0412\u0456\u0434\n\u0414\u043e\n\u0411\u0435\u0437 \u043f\u0440\u043e\u0431\u0456\u0433\u0443\n\u041e\u0431\u2019\u0454\u043c \u0434\u0432\u0438\u0433\u0443\u043d\u0430, \u043b\n\u0412\u0456\u0434\n\u0414\u043e\n\u0422\u0438\u043f \u043f\u0440\u0438\u0432\u043e\u0434\u0443\n\u041f\u043e\u0432\u043d\u0438\u0439\n\u041f\u0435\u0440\u0435\u0434\u043d\u0456\u0439\n\u0417\u0430\u0434\u043d\u0456\u0439\n\u041a\u043e\u043b\u0456\u0440\n\u041c\u0435\u0442\u0430\u043b\u0456\u043a\n\u0412\u0438\u0442\u0440\u0430\u0442\u0430 \u043f\u0430\u043b\u0438\u0432\u0430, \u043b. / 100 \u043a\u043c\n\u0412\u0456\u0434\n\u0414\u043e\n\u041c\u0456\u0441\u0442\u043e\n\u0428\u043e\u0441\u0435\n\u0417\u043c\u0456\u0448\u0430\u043d\u0438\u0439\n\u0417\u0430\u043f\u0430\u0441 \u0445\u043e\u0434\u0443 (\u043a\u043c)\n\u0412\u0456\u0434\n\u0414\u043e\n\u0404\u043c\u043d\u0456\u0441\u0442\u044c \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\u0443 (\u043a\u0412 - \u0433)\n\u0412\u0456\u0434\n\u0414\u043e\n\u041f\u043e\u0442\u0443\u0436\u043d\u0456\u0441\u0442\u044c\n\u0412\u0456\u0434\n\u0414\u043e\n\u043a.\u0441.\n\u043a\u0412\u0442\n\u0417\u0430\u0440\u044f\u0434\u043d\u0438\u0439 \u0440\u043e\u0437\u02bc\u0454\u043c\n\u0415\u043a\u043e\u043b\u043e\u0433\u0456\u0447\u043d\u0438\u0439 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\n\u0414\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0456 \u043e\u043f\u0446\u0456\u0457\n\u0412\u0438\u043d\u044f\u0442\u043a\u0438\n\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438 \u043f\u043e\u0448\u0443\u043a\u0443\n\u0420\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0438\u0439 \u043f\u043e\u0448\u0443\u043a\n\u041b\u0435\u0433\u043a\u043e\u0432\u0456\n\u0434\u043e 5\u00a0000 $\n\u0410\u0432\u0442\u043e \u0432 \u0423\u043a\u0440\u0430\u0457\u043d\u0456\n\u0420\u043e\u0437\u043c\u0438\u0442\u043d\u0435\u043d\u0456\n\u041e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0441\u0435\n\u0420\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0438\u0439 \u043f\u043e\u0448\u0443\u043a\n84\u00a0341 \u043f\u0440\u043e\u043f\u043e\u0437\u0438\u0446\u0456\u044f\n\u0417\u0432\u0438\u0447\u0430\u0439\u043d\u0435\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\n\u0422\u041e\u041f 26\nOpel Vectra 2007\nIII \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f/C (FL)\n3\u00a0999 $ \u00b7 169\u00a0718 \u0433\u0440\u043d\n295 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0414\u0438\u0437\u0435\u043b\u044c, 1.91 \u043b\n\u0422\u0435\u0440\u043d\u043e\u043f\u0456\u043b\u044c\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\nOpel Vectra C 2007 \u2022 1.9 CDTI \u2022 \u0421\u0435\u0434\u0430\u043d \u2022 \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430 \u041f\u0440\u043e\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0434\u043e\u0433\u043b\u044f\u043d\u0443\u0442\u0438\u0439 Opel Vectra 2007 \u0440\u043e\u043a\u0443 \u0437 \u043d\u0430\u0434\u0456\u0439\u043d\u0438\u043c \u0442\u0430 \u0435\u043a\u043e\u043d\u043e\u043c\u0456\u0447\u043d\u0438\u043c \u0434\u0438\u0437\u0435\u043b\u044c\u043d\u0438\u043c \u0434\u0432\u0438\u0433\u0443\u043d\u043e\u043c 1.9 CDTI \u043f\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0454 \u0432 \u0445\u043e\u0440\u043e\u0448\u043e\u043c\u0443 \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456. \u041e\u0441\u043d\u043e\u0432\u043d\u0456 \u0434\u0430\u043d\u0456: \u2022 \u0420\u0456\u043a: 2007 \u2022 \u0414\u0432\u0438\u0433\u0443\u043d: 1.9 CDTI (\u0435\u043a\u043e\u043d\u043e\u043c\u043d\u0438\u0439 \u0442\u0430 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u0438\u0439) \u2022 \u0422\u0438\u043f \u043a\u0443\u0437\u043e\u0432\u0430: \u0441\u0435\u0434\u0430\u043d \u2022 \u041a\u043e\u0440\u043e\u0431\u043a\u0430 \u043f\u0435\u0440\u0435\u0434\u0430\u0447: \u043c\u0435\u0445\u0430\u043d\u0456\u043a\u0430 \u2022 \u041a\u043b\u0456\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0421\u0442\u0430\u043d \u0430\u0432\u0442\u043e: \u2022 \u0414\u0432\u0438\u0433\u0443\u043d \u043f\u0440\u0430\u0446\u044e\u0454 \u0440\u0456\u0432\u043d\u043e, \u0437\u0430\u0432\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0431\u0435\u0437 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u2022 \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430 \u0447\u0456\u0442\u043a\u0430, \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0456 \u0432\u043c\u0438\u043a\u0430\u044e\u0442\u044c\u0441\u044f \u043f\u043b\u0430\u0432\u043d\u043e \u2022 \u041f\u0456\u0434\u0432\u0456\u0441\u043a\u0430 \u0434\u043e\u0433\u043b\u044f\u043d\u0443\u0442\u0430, \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0441\u0442\u0443\u043a\u0430\u0454 \u2022 \u0421\u0430\u043b\u043e\u043d \u0430\u043a\u0443\u0440\u0430\u0442\u043d\u0438\u0439, \u043d\u0435 \u0437\u0430\u0442\u0435\u0440\u0442\u0438\u0439 \u2022 \u0412\u0447\u0430\u0441\u043d\u043e \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043b\u043e\u0441\u044f \u0422\u041e \u2022 \u0410\u0432\u0442\u043e \u043d\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0454 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0438\u0445 \u0432\u043a\u043b\u0430\u0434\u0435\u043d\u044c \u0442\u0430 \u0433\u043e\u0442\u043e\u0432\u0435 \u0434\u043e \u043f\u043e\u0457\u0437\u0434\u043e\u043a \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0430\u0446\u0456\u044f: \u2022 \u041a\u043b\u0456\u043c\u0430\u0442-\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u2022 \u0415\u043b\u0435\u043a\u0442\u0440\u043e\u0441\u043a\u043b\u043e\u043f\u0456\u0434\u0439\u043e\u043c\u043d\u0438\u043a\u0438 \u2022 \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u0438\u0439 \u0437\u0430\u043c\u043e\u043a \u2022 \u0411\u043e\u0440\u0442\u043e\u0432\u0438\u0439 \u043a\u043e\u043c\u043f\u2019\u044e\u0442\u0435\u0440 \u2022 ABS, ESP \u2022 \u041c\u0443\u043b\u044c\u0442\u0438\u0440\u0443\u043b\u044c\n\n3 \u0433\u043e\u0434\u0438\u043d\u0438 \u0442\u043e\u043c\u0443\n\u0422\u041e\u041f 25\nVolkswagen Bora 2000\nI \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f \u2022 1.6 AT (100 \u043a.\u0441.) \u2022 Base\n4\u00a0599 $ \u00b7 195\u00a0182 \u0433\u0440\u043d\n140 \u0442\u0438\u0441. \u043a\u043c\n\u0410\u0432\u0442\u043e\u043c\u0430\u0442\n\u0411\u0435\u043d\u0437\u0438\u043d, 1.6 \u043b\n\u0421\u0442\u0440\u0438\u0439\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u0422\u043e\u0440\u0433\n\u041e\u0431\u043c\u0456\u043d\n\n\u0421\u0432\u0456\u0436\u043e\u043f\u0440\u0438\u0433\u043d\u0430\u043d\u0435 \u0430\u0432\u0442\u043e \u043d\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0456 \u0431\u0435\u0437 \u0414\u0422\u041f, \u0433\u043e\u0442\u043e\u0432\u0435 \u0434\u043e \u0435\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0456\u0457!\u0412 \u041f\u0420\u041e\u0414\u0410\u0416\u0406 \u041f\u0420\u0418\u0413\u041d\u0410\u041d\u0418\u0419 \u0417 \u041d\u0406\u041c\u0415\u0427\u0427\u0418\u041d\u0418, \u0421\u0415\u0420\u0422\u0418\u0424\u0406\u041a\u041e\u0412\u0410\u041d\u0418\u0419 \u0422\u0410 \u0413\u041e\u0422\u041e\u0412\u0418\u0419 \u0414\u041e \u041f\u041e\u0421\u0422\u0410\u041d\u041e\u0412\u041a\u0418 \u041d\u0410 \u041f\u0415\u0420\u0428\u0418\u0419 \u0412 \u0423\u041a\u0420\u0410\u0407\u041d\u0406 \u041e\u0411\u041b\u0406\u041a \u0410\u0412\u0422\u041e\u041c\u041e\u0411\u0406\u041b\u042c! \u0410\u0432\u0442\u043e \u0432\u0438\u043a\u0443\u043f\u043b\u0435\u043d\u043e \u0437 \u041d\u0456\u043c\u0435\u0447\u0447\u0438\u043d\u0438 \u0437 \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u0438\u043c \u043f\u0440\u043e\u0431\u0456\u0433\u043e\u043c 140 \u0442\u0438\u0441. \u043a\u043c (\u0432 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456 \u0432\u0438\u0442\u044f\u0433\u0438 \u0437 \u0430\u0443\u043a\u0446\u0456\u043e\u043d\u0443), \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u0438\u0439 \u043d\u0430\u0434\u0456\u0439\u043d\u0438\u043c 1.6 \u043b\u0456\u0442\u0440\u043e\u0432\u0438\u043c 8-\u043a\u043b. \u0434\u0432\u0438\u0433\u0443\u043d\u043e\u043c \u0442\u0430 \u0410\u0412\u0422\u041e\u041c\u0410\u0422\u0418\u0427\u041d\u041e\u042e \u043a\u043e\u0440\u043e\u0431\u043a\u043e\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447. \u0422\u0435\u0445\u043d\u0456\u0447\u043d\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u0431\u0435\u0437 \u0436\u043e\u0434\u043d\u0438\u0445 \u043d\u0430\u0440\u0456\u043a\u0430\u043d\u044c, \u0441\u043f\u0440\u0430\u0432\u043d\u0438\u0439 \u0442\u0430 \u0433\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u0449\u043e\u0434\u0435\u043d\u043d\u043e\u0457 \u0435\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0456\u0457 \u043d\u0430 100%. \u041a\u0443\u0437\u043e\u0432 \u0430\u0432\u0442\u043e \u0431\u0435\u0437 \u043e\u0437\u043d\u0430\u043a \u043a\u043e\u0440\u043e\u0437\u0456\u0439, \u0432 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456, \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438 \u043a\u0443\u0437\u043e\u0432\u0430 \u0432 \u0440\u0456\u0434\u043d\u0456\u0439 \u0444\u0430\u0440\u0431\u0456 (\u0433\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0445 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a). \u0417\u0430\u043c\u0456\u043d\u0435\u043d\u043e \u0442\u043e\u0440\u043c\u043e\u0437\u043d\u0456 \u043a\u043e\u043b\u043e\u0434\u043a\u0438, \u043c\u0430\u0441\u043b\u043e \u0442\u0430 \u0444\u0456\u043b\u044c\u0442\u0440\u0430. \u0423\u0441\u0456 \u0448\u0442\u0430\u0442\u043d\u0456 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0441\u043f\u0440\u0430\u0432\u043d\u0456, \u0436\u043e\u0434\u043d\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u043f\u043e \u043c\u043e\u0442\u043e\u0440\u0443 \u0442\u0430 \u043a\u043e\u0440\u043e\u0431\u0446\u0456, ABS \u0442\u0430 ESP. \u041a\u043e\u043d\u0434\u0438\u0446\u0456\u043e\u043d\u0435\u0440 \u0437\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u0438\u0439. \u0421\u0430\u043b\u043e\u043d \u0430\u0432\u0442\u043e \u043f\u0456\u0441\u043b\u044f \u043f\u0440\u043e\u0444\u0435\u0441\u0456\u0439\u043d\u043e\u0457 \u0445\u0456\u043c\u0447\u0438\u0441\u0442\u043a\u0438. \u041f\u0440\u043e\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u043b\u0435\u0433\u043a\u043e\u0441\u043f\u043b\u0430\u0432\u043d\u0438\u0445 \u0434\u0438\u0441\u043a\u0430\u0445 \u0442\u0430 \u0432\u0441\u0435\u0441\u0435\u0437\u043e\u043d\u043d\u0456\u0439 \u0440\u0435\u0437\u0438\u043d\u0456. \u042f\u043a\u0449\u043e \u0412\u0438 \u0448\u0443\u043a\u0430\u0454\u0442\u0435 \u041d\u0410\u0414\u0406\u0419\u041d\u0415 \u0442\u0430 \u041a\u041e\u041c\u0424\u041e\u0420\u0422\u041d\u0415 \u0430\u0432\u0442\u043e \u043d\u0430 \u043a\u043e\u0436\u0435\u043d\u044c \u0434\u0435\u043d\u044c \u0437\u0430 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u0456 \u0433\u0440\u043e\u0448\u0456, \u0430 \u043d\u0435 \u0434\u0436\u0435\u0440\u0435\u043b\u043e \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u0438\u0445 \u0456\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0456\u0439, \u0437\u0430\u043f\u0440\u043e\u0448\u0443\u044e \u043d\u0430 \u043e\u0433\u043b\u044f\u0434. \u041c\u043e\u0436\u043b\u0438\u0432\u0438\u0439 \u0442\u043e\u0440\u0433 \u0442\u0430 \u043e\u0431\u043c\u0456\u043d\n\n2 \u0434\u043d\u0456 \u0442\u043e\u043c\u0443\n\ud83d\udd25 \u041f\u0440\u043e\u043f\u043e\u0437\u0438\u0446\u0456\u044f \u0434\u043d\u044f\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nHO 0538 AB\n\u0422\u041e\u041f 9\nRenault Laguna 2003\nII \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f \u2022 1.9 dCi MT (107 \u043a.\u0441.) \u2022 Base\n3\u00a0200 $ \u00b7 135\u00a0808 \u0433\u0440\u043d\n250 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0414\u0438\u0437\u0435\u043b\u044c, 1.9 \u043b\n\u0422\u0435\u0440\u043d\u043e\u043f\u0456\u043b\u044c\n\n\u041f\u0440\u043e\u0434\u0430\u043c \u0432\u043b\u0430\u0441\u043d\u0435 \u0430\u0432\u0442\u043e \u0410\u0432\u0442\u043e \u0432 \u0445\u043e\u0440\u043e\u0448\u043e\u043c\u0443 \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u043e\u043c\u0443 \u0442\u0430 \u0432\u0456\u0437\u0443\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456 \u041c\u043e\u0442\u043e\u0440,\u043a\u043e\u0440\u043e\u0431\u043a\u0430 \u043f\u0440\u0430\u0446\u044e\u044e\u0442\u044c \u0447\u0443\u0434\u043e\u0432\u043e \u0425\u043e\u0434\u043e\u0432\u0430 \u0431\u0435\u0437 \u0437\u0430\u0443\u0432\u0430\u0436\u0435\u043d\u044c \u0421\u0432\u0456\u0436\u0430 \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u043a\u0430 \u041b\u044e\u0431\u0438\u0439 \u0432\u0438\u0434 \u043f\u0435\u0440\u0435\u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044f\n\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nBE 8780 ET\n\u0422\u041e\u041f 23\nOpel Astra 2006\n4\u00a0950 $ \u00b7 210\u00a0078 \u0433\u0440\u043d\n171 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0411\u0435\u043d\u0437\u0438\u043d, 1.4 \u043b\n\u041c\u0438\u043a\u043e\u043b\u0430\u0457\u0432 (\u041c\u0438\u043a\u043e\u043b\u0430\u0457\u0432\u0441\u044c\u043a\u0430)\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u041e\u0431\u043c\u0456\u043d\n\n\u0410\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u043d\u0430 \u043f\u043e\u0432\u043d\u043e\u043c\u0443 \u0445\u043e\u0434\u0443, \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u0432\u0438\u0434 \u043f\u0435\u0440\u0435\u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044f, \u043a\u0443\u0437\u043e\u0432 \u043d\u0435 \u0433\u043d\u0438\u043b\u0438\u0439, \u0434\u0432\u0438\u0433\u0443\u043d \u043f\u0440\u0430\u0446\u044e\u0454 \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u043e (\u043c\u0430\u0441\u043b\u043e \u043d\u0435 \u0431\u0435\u0440\u0435), \u0445\u043e\u0434\u043e\u0432\u0430 \u0441\u0431\u0438\u0442\u0430, \u043f\u043e \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0446\u0456 \u0432\u0441\u0435 \u043f\u0440\u0430\u0446\u044e\u0454, \u043a\u043e\u043d\u0434\u0438\u0446\u0456\u043e\u043d\u0435\u0440 \u0437\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439 (\u043f\u0440\u0430\u0446\u044e\u0454). \u0412\u0406\u0414\u0414\u0410\u042e \u041f\u0415\u0420\u0415\u0412\u0410\u0413\u0423 \u0420\u0406\u0412\u041d\u041e\u0426\u0406\u041d\u041d\u041e\u041c\u0423 \u041e\u0411\u041c\u0406\u041d\u0423 \u0410\u0411\u041e \u0417 \u0412\u0410\u0428\u041e\u042e \u0414\u041e\u041f\u041b\u0410\u0422\u041e\u042e. \u0410\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u0437\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0432 \u043c\u0456\u0441\u0442\u0456 \u0412\u043e\u0437\u043d\u0435\u0441\u0435\u043d\u0441\u044c\u043a.\n\n10 \u0434\u043d\u0456\u0432 \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nAI 4898 PC\n\u0422\u041e\u041f 21\nOpel Astra 2006\n3\u00a0300 $ \u00b7 140\u00a0052 \u0433\u0440\u043d\n333 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0413\u0430\u0437/\u0411\u0435\u043d\u0437\u0438\u043d, 1.6 \u043b\n\u041f\u0435\u0440\u0435\u044f\u0441\u043b\u0430\u0432\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u0422\u043e\u0440\u0433\n\u041e\u0431\u043c\u0456\u043d\n\n\u0413\u0430\u0437 4 !!! \u0413\u0430\u0440\u043d\u0438\u0439 \u0441\u0442\u0430\u043d!!! \u0422\u043e\u0440\u0433 \u043d\u0430 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044f!!!\n\n\u0414\u0435\u043d\u044c \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nAB 1879 KP\n\u0422\u041e\u041f 20\nDacia Logan MCV 2008\nI \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f \u2022 1.6i MT (105 \u043a.\u0441.) 7s \u2022 Base\n4\u00a0250 $ \u00b7 180\u00a0370 \u0433\u0440\u043d\n173 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0413\u0430\u0437/\u0411\u0435\u043d\u0437\u0438\u043d, 1.6 \u043b\n\u0412\u0456\u043d\u043d\u0438\u0446\u044f\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u0422\u043e\u0440\u0433\n\u041e\u0431\u043c\u0456\u043d\n\n\u041f\u0440\u043e\u0434\u0430\u043c \u043f\u0440\u043e\u0441\u0442\u0435 \u043d\u0430\u0434\u0456\u0439\u043d\u0435 \u0442\u0430 \u0431\u0435\u0437\u0432\u0456\u0434\u043c\u043e\u0432\u043d\u0435 \u0430\u0432\u0442\u043e \u044f\u043a \u0430\u0432\u0442\u043e\u043c\u0430\u0442 \u043a\u0430\u043b\u0430\u0448\u043d\u0438\u043a\u043e\u0432\u0430, \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u043f\u0456\u0434\u0432\u043e\u0434\u0438\u0442\u044c \u043d\u0435\u0437\u0430\u043c\u0456\u043d\u043d\u0438\u0439 \u043f\u043e\u043c\u0456\u0447\u043d\u0438\u043a \u043f\u043e \u0433\u043e\u0441\u043f\u043e\u0434\u0430\u0440\u0441\u0442\u0432\u0443 \u0442\u0430 \u0440\u043e\u0431\u043e\u0442\u0456 \u0410\u0432\u0442\u043e \u0432 \u0445\u043e\u0440\u043e\u0448\u043e\u043c\u0443 \u0442\u0430 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456 \u0440\u0456\u0434\u043d\u0438\u0439 \u043f\u0440\u043e\u0431\u0456\u0433 \u0431\u0443\u0434 \u044f\u043a\u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0438 \u0414\u0432\u0438\u0433\u0443\u043d \u043f\u0440\u0430\u0446\u044e\u0454 \u044f\u043a \u0433\u043e\u0434\u0438\u043d\u043d\u0438\u043a \u0449\u043e \u043d\u0430 \u0433\u0430\u0437\u0443 \u0449\u043e \u043d\u0430 \u0431\u0435\u043d\u0437\u0438\u043d\u0456 \u0434\u0443\u0436\u0435 \u0435\u043a\u043e\u043d\u043e\u043c\u0456\u0447\u043d\u0430 \u0432\u0438\u0442\u0440\u0430\u0442\u0430 \u043f\u0430\u043b\u0438\u0432\u0430, \u043c\u0430\u0441\u043b\u0430 \u043d\u0435 \u0431\u0438\u0440\u0435 \u0432\u0437\u0430\u0433\u0430\u043b\u0456 \u043d\u0435 \u0434\u0438\u043c\u0438\u0442\u044c \u043d\u0435 \u0441\u043e\u043f\u0443\u043d\u0438\u0442\u044c \u0457\u0434\u0435 \u0434\u043e\u0431\u0440\u0435 \u041a\u041f\u041f \u0431\u0435\u0437 \u0436\u043e\u0434\u043d\u0438\u0445 \u0437\u0430\u0443\u0432\u0430\u0436\u0435\u043d\u044c \u0432\u0441\u0435 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0454 \u0447\u0456\u0442\u043a\u043e \u0431\u0435\u0437 \u043f\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u0456\u0445 \u0448\u0443\u043c\u0456\u0432 \u0425\u043e\u0434\u043e\u0432\u0430 \u0432\u0441\u044f \u043e\u0431\u0441\u043b\u0443\u0436\u0435\u043d\u043d\u0430 \u0432\u0456\u0434 \u0430 \u0434\u043e \u044f \u0436\u043e\u0434\u043d\u0438\u0445 \u0437\u0430\u0443\u0432\u0430\u0436\u0435\u043d\u044c, \u0436\u043e\u0434\u043d\u0438\u0445 \u0437\u0432\u0443\u043a\u0456\u0432 \u0447\u0438 \u0433\u0440\u0443\u043a\u0456\u0432 \u041a\u0443\u0437\u043e\u0432 \u0431\u0435\u0437 \u0440\u0438\u0436\u0438\u043a\u0456\u0432 \u0432\u0437\u0430\u0433\u0430\u043b\u0456, \u0434\u043d\u043e \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u0432\u0441\u0435 \u0446\u0456\u043b\u0435, \u0441\u0442\u0430\u043a\u0430\u043d\u0438 \u0446\u0456\u043b\u0456, \u043b\u043e\u043d\u0436\u0435\u0440\u043e\u043d\u0438 \u0446\u0456\u043b\u0456 \u0432 \u0434\u0442\u043f \u043d\u0435 \u0431\u0443\u043b\u0430 \u0421\u0430\u043b\u043e\u043d \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0438\u0439 \u0442\u0430 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u0438\u0439 \u0432\u0441\u0435 \u043e\u0445\u0430\u0439\u043d\u043e \u0442\u0430 \u0447\u0438\u0441\u0442\u0435\u043d\u044c\u043a\u043e \u0434\u0443\u0436\u0435 \u0432\u043c\u0456\u0441\u0442\u043a\u0438\u0439 \u0431\u0430\u0433\u0430\u0436\u043d\u0438\u043a \u0437\u0440\u0443\u0447\u043d\u043e \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u043d\u044f \u0431\u0443\u0434\u044c \u044f\u043a\u0438\u0445 \u0440\u0435\u0447\u0435\u0439 \u043f\u0440\u0438 \u0441\u043a\u043b\u0430\u0434\u0430\u043d\u043d\u0456 \u0437\u0430\u0434\u043d\u044c\u043e\u0433\u043e \u0440\u044f\u0434\u0443 \u0441\u0438\u0434\u0456\u043d\u044c \u0425\u043e\u0440\u043e\u0448\u0430 \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u0430 \u043c\u0443\u0437\u0438\u043a\u0430 \u0433\u0440\u0430\u0454 \u0449\u043e \u0442\u0440\u0435\u0431\u0430 \u043f\u0456\u0447\u043a\u0430 \u0434\u0443\u0454 \u043d\u0430 \u0432\u0441\u0456 \u0433\u0440\u043e\u0448\u0456 \u0432\u0441\u0435 \u043f\u0440\u0430\u0446\u044e\u0454 \u0425\u043e\u0440\u043e\u0448\u0456 \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u0456 \u0442\u0438\u0442\u0430\u043d\u0438 \u0432\u0456\u0434 opel \u0442\u0430 \u0437\u0438\u043c\u043d\u044f \u0433\u0443\u043c\u0430 \u0431\u0456\u043b\u044c\u0448\u0435 60% \u043f\u0440\u043e\u0442\u0435\u043a\u0442\u043e\u0440 \u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438 \u0432 \u043f\u043e\u0440\u044f\u0434\u043a\u0443 \u0433\u0430\u0437 \u0432\u043f\u0438\u0441\u0430\u043d\u0438\u0439 \u0432 \u0442\u0435\u0445\u043f\u0430\u0441\u043f\u043e\u0440\u0442 \u0420\u0415\u0410\u041b\u042c\u041d\u041e\u041c\u0423 \u041f\u041e\u041a\u0423\u041f\u0426\u042e \u0425\u041e\u0420\u041e\u0428\u0418\u0419 \u0422\u041e\u0420\u0413 \u041b\u0418\u0428\u0415 \u0411\u0406\u041b\u042f \u0410\u0412\u0422\u041e \u041f\u041e \u0424\u0410\u041a\u0422\u0423 \u041c\u041e\u0416\u041b\u0418\u0412\u0418\u0419 \u041e\u0411\u041c\u0406\u041d \u0417 \u0412\u0410\u0428\u041e\u042e \u0414\u041e\u041f\u041b\u0410\u0422\u041e\u042e \u0412 \u041c\u041e\u042e \u0421\u0422\u041e\u0420\u041e\u041d\u0423 \u0412\u0441\u0456\u043c \u0432\u0434\u0430\u043b\u0438\u0445 \u043f\u0440\u043e\u0434\u0430\u0436\u0456\u0432 \u0442\u0430 \u043f\u043e\u043a\u0443\u043f\u043e\u043a \u0430 \u0433\u043e\u043b\u043e\u0432\u043d\u0435 \u041c\u0418\u0420\u041d\u041e\u0413\u041e \u041d\u0415\u0411\u0410\n\n7 \u0433\u043e\u0434\u0438\u043d \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nBH 1440 PI\n\u0422\u041e\u041f 18\nMazda 3 2006\nI \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f/BK \u2022 1.6i AT (105 \u043a.\u0441.) \u2022 Base\n4\u00a0400 $ \u00b7 186\u00a0736 \u0433\u0440\u043d\n207 \u0442\u0438\u0441. \u043a\u043c\n\u0410\u0432\u0442\u043e\u043c\u0430\u0442\n\u0411\u0435\u043d\u0437\u0438\u043d, 1.6 \u043b\n\u041e\u0434\u0435\u0441\u0430\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0443 \u0432\u0430\u0448\u0435 \u043c\u0456\u0441\u0442\u043e\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u041e\u0431\u043c\u0456\u043d\n\n\u041e\u0424\u0406\u0426\u0406\u0419\u041d\u0418\u0419 \u0410\u0412\u0422\u041e\u041c\u041e\u0411\u0406\u041b\u042c!!!! 1.6.\u0411\u0415\u041d\u0417\u0418\u041d.\u0410\u0412\u0422\u041e\u041c\u0410\u0422.\u041c\u0423\u041b\u042c\u0422\u0418 \u0420\u0423\u041b\u042c.\u041f\u0406\u0414\u0406\u0413\u0420\u0406\u0412\u0418 \u0421\u0418\u0414\u0406\u041d\u042c.\u041a\u0420\u0423\u0407\u0417 \u041a\u041e\u041d\u0422\u0420\u041e\u041b\u042c.\u041a\u041b\u0406\u041c\u0410\u0422 \u041a\u041e\u041d\u0422\u0420\u041e\u041b\u042c (\u0437\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439).\u041f\u041e\u0412\u041d\u0410 \u0415\u041b\u0415\u041a\u0422\u0420\u0418\u041a\u0410.\u0406 \u0422.\u0414\u2026\u2026 \u041c\u0430\u0448\u0438\u043d\u0430 \u0432 \u043e\u0442\u043b\u0456\u0447\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456, \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u043e\u0431\u0441\u043b\u0443\u0436\u0435\u043d\u0430, \u0437\u0430\u043c\u0456\u043d\u0435\u043d\u0456 \u0432\u0441\u0456 \u0440\u043e\u0441\u0445\u0456\u0434\u043d\u0438\u043a\u0438,\u0445\u043e\u0440\u043e\u0448\u0430 \u0440\u0435\u0437\u0438\u043d\u0430, \u043d\u043e\u0432\u0438\u0439 \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440.\u041f\u043e \u043c\u0430\u0448\u0438\u043d\u0456 \u0432\u0441\u0435 \u043f\u0440\u0430\u0446\u044e\u0454, \u043a\u043e\u0436\u043d\u0430 \u043a\u043d\u043e\u043f\u043e\u0447\u043a\u0430, \u0434\u0432\u0438\u0433\u0443\u043d \u043f\u0440\u0430\u0446\u044e\u0454 \u044f\u043a \u0433\u043e\u0434\u0438\u043d\u043d\u0438\u043a,\u043c\u0430\u0441\u043b\u043e\u043c \u043d\u0435 \u0431\u0435\u0440\u0435, \u043f\u0440\u0430\u0446\u044e\u0454 \u0442\u0438\u0445\u043e \u0456 \u0440\u0456\u0432\u043d\u043e,\u0430\u0432\u0442\u043e\u043c\u0430\u0442 \u043f\u0440\u0430\u0446\u044e\u0454 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e,\u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0454 \u043a\u043e\u0436\u043d\u0443 \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u043f\u043b\u0430\u0432\u043d\u043e \u0456 \u0447\u0456\u0442\u043a\u043e,\u043f\u043e \u0445\u043e\u0434\u043e\u0432\u0456\u0439 \u0447\u0430\u0441\u0442\u0438\u043d\u0456 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u043d\u0430\u0440\u0456\u043a\u0430\u043d\u044c \u043d\u0435\u043c\u0430\u0454 \u043d\u0456\u044f\u043a\u0438\u0445.\u0421\u0430\u043b\u043e\u043d \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0432 \u0445\u043e\u0440\u043e\u0448\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456 .\u0414\u0443\u0436\u0435 \u0442\u0435\u0440\u043c\u0456\u043d\u043e\u0432\u0438\u0439 \u043f\u0440\u043e\u0434\u0430\u0436, \u043c\u0430\u0448\u0438\u043d\u0430 \u0432\u0456\u0434 \u0432\u043b\u0430\u0441\u043d\u0438\u043a\u0430,\u041e\u0434\u0435\u0441\u044c\u043a\u0430 \u0440\u0435\u0433\u0456\u0441\u0442\u0440\u0430\u0446\u0456\u044f, \u043c\u0430\u0448\u0438\u043d\u0443 \u043f\u0440\u043e\u0434\u0430\u0454\u043c \u0437 \u043f\u043e\u0432\u043d\u0438\u043c \u043f\u0435\u0440\u0435\u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044f\u043c \u043d\u0430 \u043d\u043e\u0432\u043e\u0433\u043e \u0432\u043b\u0430\u0441\u043d\u0438\u043a\u0430, \u043c\u0430\u0448\u0438\u043d\u043e\u044e \u0431\u0443\u0434\u0435\u0442\u0435 \u0437\u0430\u0434\u043e\u0432\u043e\u043b\u0435\u043d\u0456, \u0434\u0443\u0436\u0435 \u0435\u043a\u043e\u043d\u043e\u043c\u043d\u0430, \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u0430, \u0441\u0456\u043c\u0435\u0439\u043d\u0430 \u043c\u0430\u0448\u0438\u043d\u0430.\n\n15 \u0433\u043e\u0434\u0438\u043d \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nKE 3010 AM\n\u0422\u041e\u041f 17\nMazda 3 2005\nI \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f/BK \u2022 2.0i AT (150 \u043a.\u0441.) \u2022 Base\n4\u00a0800 $ \u00b7 203\u00a0712 \u0433\u0440\u043d\n259 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0413\u0430\u0437/\u0411\u0435\u043d\u0437\u0438\u043d, 2 \u043b\n\u041a\u0430\u043c'\u044f\u043d\u0441\u044c\u043a\u0435 (\u0414\u043d\u0456\u043f\u0440\u043e\u0434\u0437\u0435\u0440\u0436\u0438\u043d\u0441\u044c\u043a)\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u0422\u043e\u0440\u0433\n\n\u041f\u0440\u043e\u0434\u0430\u043c Mazda 3 Sport 2.0 \u043d\u0430 \u0431\u0430\u0433\u0430\u0442\u0456\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0430\u0446\u0456\u0457 2005 \u0440\u043e\u043a\u0443 \u0432\u0438\u043f\u0443\u0441\u043a\u0443, \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0430\u043d\u0430 \u0422\u041e \u043c\u0430\u0441\u043b\u043e, \u0444\u0456\u043b\u044c\u0442\u0440\u0438. 2 \u043a\u043b\u044e\u0447\u0456, \u0441\u0438\u0433\u043d\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f \u0434\u0432\u043e\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u044f \u0413\u0411\u041e 4-\u0433\u043e \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f \u0432\u043f\u0438\u0441\u0430\u043d\u043e \u0432 \u0442\u0435\u0445\u043f\u0430\u0441\u043f\u043e\u0440\u0442. \u041d\u043e\u0432\u0456: \u0430\u043c\u043e\u0440\u0442\u0438\u0437\u0430\u0442\u043e\u0440\u0438 \u0437\u0430\u0434\u043d\u0456, \u043f\u0440\u0443\u0436\u0438\u043d\u0438, \u043f\u0456\u0434\u043a\u0440\u0438\u043b\u043a\u0438. \u0410\u0432\u0442\u043e \u0437\u0430\u043c\u043e\u0432\u043b\u0435\u043d\u043e \u0456 \u0437\u0430\u0442\u0443\u0448\u0435\u043d\u043e! \u0427\u0443\u0434\u043e\u0432\u0430 \u0437\u0438\u043c\u043e\u0432\u0430 \u0433\u0443\u043c\u0430 R16! \u0404 \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u043a\u0430. \u041f\u0435\u0440\u0435\u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044f.\n\n2 \u0434\u043d\u0456 \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nAE 1871 OP\n\u0422\u041e\u041f 16\n\u0422\u0456\u043b\u044c\u043a\u0438 \u043d\u0430 AUTO.RIA\nSkoda Fabia 2007\nII \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f \u2022 1.4 MT (86 \u043a.\u0441.) \u2022 Elegance\n4\u00a0900 $ \u00b7 207\u00a0956 \u0433\u0440\u043d\n204 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0413\u0430\u0437/\u0411\u0435\u043d\u0437\u0438\u043d, 1.39 \u043b\n\u0414\u043d\u0456\u043f\u0440\u043e (\u0414\u043d\u0456\u043f\u0440\u043e\u043f\u0435\u0442\u0440\u043e\u0432\u0441\u044c\u043a)\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u0422\u043e\u0440\u0433\n\n\u0410\u0432\u0442\u043e \u0432 \u0445\u043e\u0440\u043e\u0448\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456, \u0441\u043b\u0456\u0434\u043a\u0443\u0432\u0430\u0432 \u0437\u0430 \u0430\u0432\u0442\u0456\u0432\u043a\u043e\u0439, \u0446\u044c\u043e\u043c\u0443 \u0454 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f \u0437 \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0438\u043c\u0438 \u0422\u041e, \u0447\u0435\u043a\u0430\u043c\u0438, \u0433\u0440\u043e\u0448\u0435\u0439 \u043d\u0435 \u0436\u0430\u043b\u043a\u0443\u0432\u0430\u0432 \u0430\u0434\u0436\u0435 \u0430\u0432\u0442\u0456\u0432\u043a\u0430 \u0434\u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u043c\u0435\u043d\u0456 \u0432 \u0433\u0430\u0440\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456 \u0456 \u0445\u043e\u0442\u0456\u043b\u043e\u0441\u044c \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0457\u0457 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e. \u041d\u043e\u0432\u0456 \u0442\u043e\u0440\u043c\u043e\u0437\u043d\u0456 \u0434\u0438\u0441\u043a\u0438, \u043a\u043e\u043b\u043e\u0434\u043a\u0438, \u043f\u0435\u0440\u0435\u0434, \u0437\u0430\u0434, \u0437\u0430\u043c\u0456\u043d\u0435\u043d\u0456 \u0441\u0442\u0443\u043f\u0438\u0447\u043d\u0456 \u043f\u0456\u0434\u0448\u0438\u043f\u043d\u0438\u043a\u0438, \u043f\u0456\u0434\u0448\u0438\u043f\u043d\u0438\u043a\u0438 \u043e\u043f\u043e\u0440\u0438, \u043b\u043e\u0431\u043e\u0432\u0435 \u0441\u043a\u043b\u043e Pilkington, \u0432\u043e\u0434\u044f\u043d\u0430 \u043f\u043e\u043c\u043f\u0430, \u043a\u043e\u0442\u0443\u0448\u043a\u0438 \u0437\u0430\u043f\u0430\u043b\u044e\u0432\u0430\u043d\u043d\u044f, \u0440\u0430\u0434\u0456\u0430\u0442\u043e\u0440, \u043f\u0456\u0434\u0432\u0456\u0441\u043a\u0430 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e Sach, \u0432\u043c\u0456\u0440\u0443 \u043c'\u044f\u043a\u0430, \u0442\u0440\u0438\u043c\u0430\u0454 \u0434\u043e\u0440\u043e\u0433\u0443 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e, 16 RS \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b \u0434\u0438\u0441\u043a\u0438, \u0433\u0443\u043c\u0430 \u0437\u0438\u043c\u0430 \u0432 \u0445\u043e\u0440\u043e\u0448\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456, \u0432\u0441\u0456 \u0437\u0430\u043c\u0456\u043d\u043d\u0438\u043a\u0438 \u0447\u0456\u0442\u043a\u043e \u043f\u043e \u0440\u0435\u0433\u043b\u0430\u043c\u0435\u043d\u0442\u0443, \u043c\u0430\u0441\u043b\u043e \u0437\u0430\u043b\u0438\u0432\u0430\u0432 Motul 6100 syn-nergy \u043a\u043e\u0436\u043d\u0456 8000\u043a\u043c, \u0433\u0430\u0437/\u0431\u0435\u043d\u0437\u0438\u043d, 1.4\u043b \u0434\u0432\u0438\u0433\u0443\u043d \u043d\u0430\u0439\u043d\u0430\u0434\u0456\u0439\u043d\u0456\u0448\u0438\u0439 \u0456 \u043d\u0430\u0439\u0435\u043a\u043e\u043d\u043e\u043c\u043d\u0456\u0448\u0438\u0439 \u0432 \u043b\u0456\u043d\u0456\u0439\u0446\u0456 \u0434\u0432\u0438\u0433\u0443\u043d\u0456\u0432 \u0428\u043a\u043e\u0434\u0438. \u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0435 \u0442\u0430 \u0432\u043f\u0438\u0441\u0430\u043d\u0435 \u0432 \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u0438\u0439 \u043f\u0430\u0441\u043f\u043e\u0440\u0442 \u0413\u0411\u041e\n\n\u0414\u0435\u043d\u044c \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nBI 7552 HA\n\u0422\u041e\u041f 15\nRenault Scenic 2008\nII \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f (FL) \u2022 1.9 dCi MT (130 \u043a.\u0441.) FAP \u2022 Base\n4\u00a0850 $ \u00b7 205\u00a0834 \u0433\u0440\u043d\n260 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0414\u0438\u0437\u0435\u043b\u044c, 1.9 \u043b\n\u0414\u0440\u043e\u0433\u043e\u0431\u0438\u0447\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\n\u041f\u0440\u043e\u0434\u0430\u043c \u0433\u0430\u0440\u043d\u0435 \u0442\u0430 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u0435 \u0430\u0432\u0442\u043e. \u0410\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u043e\u0431\u0441\u043b\u0443\u0436\u0435\u043d\u0438\u0439, \u043c\u043e\u0442\u043e\u0440 \u0441\u0430\u043c\u0438\u0439 \u043d\u0430\u0434\u0456\u0439\u043d\u0438\u0439 1,9 \u043a\u043f\u043f 6 \u043f\u0435\u0440\u0435\u0434\u0430\u0447. \u041c\u043e\u0442\u043e\u0440 \u043c\u0430\u0454 \u0434\u0443\u0436\u0435 \u0434\u043e\u0431\u0440\u0443 \u0442\u044f\u0433\u0443, \u043d\u0435 \u0434\u0438\u043c\u0438\u0442\u044c \u043c\u0430\u0441\u043b\u0430 \u043d\u0435 \u0431\u0435\u0440\u0435 \u0435\u043a\u043e\u043d\u043e\u043c\u0456\u0447\u043d\u0438\u0439. \u0425\u043e\u0434\u043e\u0432\u0430 \u0431\u0435\u0437 \u0437\u0430\u0443\u0432\u0430\u0436\u0435\u043d\u044c \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0441\u0442\u0443\u043a\u0430\u0454 \u0442\u0430 \u0441\u0442\u0443\u043a\u0430\u0442\u0438 \u043d\u0435 \u0431\u0443\u0434\u0435 \u043c\u0456\u043d\u0456\u043c\u0443\u043c \u043f\u0430\u0440\u0443 \u0440\u043e\u043a\u0456\u0432. \u0420\u0435\u0437\u0438\u043d\u0430 \u0437\u0438\u043c\u043e\u0432\u0430. \u0421\u0430\u043b\u043e\u043d \u0432 \u0433\u0430\u0440\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456, \u0433\u0430\u0440\u043d\u0430 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0430\u0446\u0456\u044f \u0411\u0435\u0437\u043a\u043b\u044e\u0447\u043e\u0432\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u043d\u0430 \u0432\u0441\u0456\u0445 \u0434\u0432\u0435\u0440\u043a\u0430\u0445 \u0442\u0430 \u0431\u0430\u0433\u0430\u0436\u043d\u0438\u043a\u0443 \u041f\u0456\u0434\u0456\u0433\u0440\u0456\u0432 \u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0445 \u0441\u0438\u0434\u0456\u043d\u044c \u041a\u043b\u0456\u043c\u0430\u0442 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0413\u0430\u0440\u043d\u0430 \u043c\u0443\u0437\u0438\u043a\u0430, \u0442\u0430 \u0449\u0435 \u0431\u0430\u0433\u0430\u0442\u043e \u0437\u0440\u0443\u0447\u043d\u0438\u0445 \u0434\u0440\u0456\u0431\u043d\u0438\u0446\u044c. \u0421\u0430\u043b\u043e\u043d \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0435\u0440. \u0412\u0441\u0456 \u0432\u0456\u043a\u043d\u0430 \u0440\u0456\u0434\u043d\u0456 \u0440\u0430\u0437\u043e\u043c \u0437 \u043b\u043e\u0431\u043e\u0432\u0438\u043c. \u041c\u043e\u0436\u043b\u0438\u0432\u0438\u0439 \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0447\u043d\u0438\u0439 \u0442\u043e\u0440\u0433 \u0431\u0456\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f.\n\n5 \u0433\u043e\u0434\u0438\u043d \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nBX 7590 BM\n\u0422\u041e\u041f 14\n\u0422\u0456\u043b\u044c\u043a\u0438 \u043d\u0430 AUTO.RIA\nRenault Kangoo 2008\nI \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f (FL) \u2022 1.5 dCi MT (82 \u043a.\u0441.) \u2022 Base\n4\u00a0950 $ \u00b7 210\u00a0078 \u0433\u0440\u043d\n290 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0414\u0438\u0437\u0435\u043b\u044c, 1.5 \u043b\n\u041a\u0430\u043b\u0438\u043d\u0456\u0432\u043a\u0430 (\u0412\u0456\u043d\u043d\u0438\u0446\u044c\u043a\u0430)\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u0422\u043e\u0440\u0433\n\n\u041a\u0443\u0437\u043e\u0432 \u0430\u0432\u0442\u043e \u043d\u0435 \u0433\u043d\u0438\u043b\u0438\u0439, \u0432 \u0440\u0456\u0434\u043d\u0456\u0439 \u0444\u0430\u0440\u0431\u0456, \u043c\u0430\u0454 \u0432\u0456\u043a\u043e\u0432\u0456 \u0437\u043c\u0456\u043d\u0438. \u041f\u043e\u0440\u043e\u0433\u0438, \u0434\u043d\u0438\u0449\u0435 \u0432\u0442\u0440\u0443\u0447\u0430\u043d\u044c \u043d\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u044e\u0442\u044c. \u041f\u0456\u0441\u043b\u044f \u043f\u0440\u0438\u0434\u0431\u0430\u043d\u043d\u044f \u0430\u0432\u0442\u043e \u0431\u0443\u043b\u043e \u0443\u0441\u0443\u043d\u0443\u0442\u043e \u0441\u043f\u043e\u0436\u0438\u0432\u0430\u043d\u043d\u044f \u043e\u043b\u0438\u0432\u0438, \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u043e\u0432\u0430\u043d\u043e \u0444\u043e\u0440\u0441\u0443\u043d\u043a\u0438, \u0442\u0443\u0440\u0431\u0456\u043d\u0443, \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0430 \u0437\u0430\u043c\u0456\u043d\u0430 \u0413\u0420\u041c. \u041a\u041e\u041d\u0414\u0418\u0426\u0406\u041e\u041d\u0415\u0420 \u043f\u0440\u0430\u0446\u044e\u0454, \u0437\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439. \u0420\u0435\u0441\u0442\u0430\u0432\u0440\u043e\u0432\u0430\u043d\u043e \u0437\u0430\u0434\u043d\u044e \u0431\u0430\u043b\u043a\u0443. \u0417\u0430\u043c\u0456\u043d\u0435\u043d\u043e \u0440\u0435\u043b\u0435 \u0456 \u0441\u0432\u0456\u0447\u043a\u0438 \u043d\u0430\u043a\u0430\u0437\u0443, \u0434\u0430\u0442\u0447\u0438\u043a \u0442\u0438\u0441\u043a\u0443 \u043f\u0430\u043b\u0438\u0432\u0430. \u0413\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u0443 \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u043e \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f. \u0417\u0430\u043c\u0456\u043d\u0435\u043d\u043e \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442 \u0449\u0435\u043f\u043b\u0435\u043d\u043d\u044f. \u0421\u0432\u0456\u0436\u0435 \u043c\u0430\u0441\u0442\u0438\u043b\u043e, \u0430\u043d\u0442\u0438\u0444\u0440\u0438\u0437. \u0425\u0442\u043e \u0431\u0430\u0436\u0430\u0454 \u0430\u0432\u0442\u043e \u0434\u0435\u0448\u0435\u0432\u0448\u0435, \u043f\u043e \u043d\u0438\u0437\u0443 \u0440\u0438\u043d\u043a\u0443-\u043a\u0443\u043f\u0443\u0439\u0442\u0435 \u0456 \u0437\u0430\u0439\u043c\u0430\u0439\u0442\u0435\u0441\u044c! \u041f\u0440\u043e\u0434\u0430\u044e, \u0443 \u0437\u0432'\u044f\u0437\u043a\u0443 \u0456\u0437 \u043f\u0440\u0438\u0434\u0431\u0430\u043d\u043d\u044f\u043c \u0430\u0432\u0442\u043e \u0434\u0435\u0448\u0435\u0432\u0448\u0435 (\u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u043e \u0456 \u043f\u043e \u0414\u043e\u043d\u0435\u0446\u044c\u043a\u0456\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0456). \u0414\u043e\u043f\u043e\u043c\u043e\u0433\u0438 \u0432 \u043f\u0440\u043e\u0434\u0430\u0436\u0443 \u0456 \u043a\u0443\u043f\u0456\u0432\u043b\u0456 \u0430\u0432\u0442\u043e \u043d\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u044e. \u041f\u0435\u0440\u0435\u043a\u0443\u043f\u0430\u043c, \u0446\u0456\u043d\u0430 \u043d\u0435 \u0441\u043e\u043b\u043e\u0434\u043a\u0430. \u041d\u0430 \u0437\u0432'\u044f\u0437\u043a\u0443.\n\n2 \u0434\u043d\u0456 \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nAT 4140 IC\n\u0422\u041e\u041f 14\nVolkswagen Golf 2004\nV \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f/Typ 1K \u2022 1.6 \u041c\u0422 (102 \u043a.\u0441.)\n4\u00a0700 $ \u00b7 199\u00a0468 \u0433\u0440\u043d\n386 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0413\u0430\u0437/\u0411\u0435\u043d\u0437\u0438\u043d, 1.6 \u043b\n\u041a\u043e\u0440\u043e\u0441\u0442\u0435\u043d\u044c\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u0422\u043e\u0440\u0433\n\n\u041c\u041e\u0416\u041b\u0418\u0412\u0418\u0419 \u041f\u0420\u0418\u0413\u041e\u041d \u0412 \u0411\u0423\u0414\u042c \u042f\u041a\u0415 \u041c\u0406\u0421\u0422\u041e \u0410\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u0432 \u0440\u0456\u0434\u043d\u0456\u0439 \u0444\u0430\u0440\u0431\u0456, 1,6 \u0433\u0430\u0437/\u0431\u0435\u043d\u0437, \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u043e \u0432 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456, \u0449\u043e \u043f\u043e \u0445\u043e\u0434\u043e\u0432\u0456\u0439, \u0449\u043e \u043f\u043e \u043c\u043e\u0442\u043e\u0440\u0443 \u0442\u0430\u043a \u0456 \u043f\u043e \u043a\u043e\u0440\u043e\u0431\u0446\u0456, \u0440\u043e\u0437\u0445\u0456\u0434\u043d\u0438\u043a\u0438 \u0437\u0430\u043c\u0456\u043d\u0435\u043d\u0456, \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440 \u043d\u043e\u0432\u0438\u0439, \u043a\u043e\u043d\u0434\u0438\u0446\u0456\u043e\u043d\u0435\u0440 \u0437\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439, \u0434\u0443\u0454 \u0434\u0443\u0436\u0435 \u0434\u043e\u0431\u0440\u0435, \u043f\u043e \u043a\u0443\u0437\u043e\u0432\u0443 \u0431\u0435\u0437 \u043a\u043e\u0440\u043e\u0437\u0456\u0457, \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0430\u0446\u0456\u044f \u0445\u043e\u0440\u043e\u0448\u0430, \u0441\u0430\u043b\u043e\u043d \u0434\u0443\u0436\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0439, \u0432\u0438\u0433\u043b\u044f\u0434\u0430\u0454 \u0434\u0443\u0436\u0435 \u0433\u0430\u0440\u043d\u043e, \u0441\u0442\u043e\u044f\u0442\u044c \u0442\u0438\u0442\u0430\u043d\u0438 R17, \u0430\u043a\u0443\u0441\u0442\u0438\u043a\u0430 \u0432\u0456\u0434 6-\u0433\u043e \u0433\u043e\u043b\u044c\u0444\u0430, \u0433\u0443\u043c\u0430 \u0433\u0430\u0440\u043d\u0430, \u0431\u0456\u043b\u044c\u0448 \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e \u043f\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443\n\n5 \u0434\u043d\u0456\u0432 \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nBC 6157 CO\n\u0422\u041e\u041f 13\nDaewoo Lanos 2007\nI \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f\n1\u00a0850 $ \u00b7 78\u00a0514 \u0433\u0440\u043d\n153 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0413\u0430\u0437/\u0411\u0435\u043d\u0437\u0438\u043d, 1.5 \u043b\n\u0414\u0440\u043e\u0433\u043e\u0431\u0438\u0447\n\u0412\u043f\u0435\u0440\u0448\u0435 \u043d\u0430 AUTO.RIA\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\n\u041f\u0440\u043e\u0434\u0430\u043c Daewoo lanos, \u043f\u043e\u043b\u044c\u0441\u044c\u043a\u043e\u0457 \u0437\u0431\u0456\u0440\u043a\u0438 , \u043c\u0430\u0448\u0438\u043d\u0430 \u0432 \u0434\u0443\u0436\u0435 \u0433\u0430\u0440\u043d\u043e\u043c\u0443 \u0442\u0430 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456 , \u043f\u043e \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u043e\u043c\u0443 \u043f\u043b\u0430\u043d\u0456 \u0432\u0441\u0435 \u043e\u0431\u0441\u043b\u0443\u0436\u0435\u043d\u0430 \u0432\u0456\u0434 \u0430 \u0434\u043e \u044f , \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0435 \u0434\u043e\u0440\u043e\u0433\u0435 \u0413\u0411\u041e 4 \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f , \u0434\u0432\u0438\u0433\u0443\u043d \u043f\u0440\u0430\u0446\u044e\u0454 \u044f\u043a \u0433\u043e\u0434\u0438\u043d\u043d\u0438\u043a , \u0445\u043e\u0434\u043e\u0432\u0430 \u0432\u0441\u044f \u043f\u0435\u0440\u0435\u0431\u0440\u0430\u043d\u0430 , \u043f\u043e \u043a\u0443\u0437\u043e\u0432\u0456 \u043d\u0435 \u0433\u043d\u0438\u043b\u0438\u0439 , \u0437\u0438\u043c\u043e\u0432\u0430 \u0433\u0443\u043c\u0430 , \u043d\u043e\u0432\u0438\u0439 \u0430\u043a\u0443\u043c\u0443\u043b\u044f\u0442\u043e\u0440\n\n10 \u0433\u043e\u0434\u0438\u043d \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nAA 4931 AH\n\u0422\u041e\u041f 13\nAudi A6 1999\nC5/4B\n2\u00a0250 $ \u00b7 95\u00a0490 \u0433\u0440\u043d\n510 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0413\u0430\u0437/\u0411\u0435\u043d\u0437\u0438\u043d, 1.8 \u043b\n\u0411\u0456\u043b\u043e\u0433\u043e\u0440\u043e\u0434\u043a\u0430\n\u0422\u043e\u0440\u0433\n\u0411\u0443\u0432 \u0432 \u0414\u0422\u041f\n\n\u041f\u0440\u043e\u0434\u0430\u043c \u0410\u0443\u0434\u0456 \u04106 \u0410\u0432\u0430\u043d\u0442 1.8 \u0442\u0443\u0440\u0431\u043e 20 \u043a\u043b\u0430\u043f\u0430\u043d\u0456\u0432, \u043f\u0456\u0441\u043b\u044f \u0430\u0432\u0430\u0440\u0456\u0457. \u0422\u0440\u0435\u0431\u0430 \u043c\u0456\u043d\u044f\u0442\u0438 \u0437\u0430\u0434\u043d\u044e \u0431\u0430\u043b\u043a\u0443 \u0442\u0430 \u0437\u0430\u0434\u043d\u0454 \u043f\u0440\u0430\u0432\u0435 \u043a\u0440\u0438\u043b\u043e. \u0414\u0432\u0438\u0433\u0443\u043d, \u041a\u041f\u041f \u0443 \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456, \u043c\u0430\u0441\u043b\u0430 \u043d\u0435 \u0431\u0435\u0440\u0435. \u041c\u043e\u0436\u043b\u0438\u0432\u0438\u0439 \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u0438\u0439 \u043e\u0431\u043c\u0456\u043d \u0437 \u043c\u043e\u0454\u044e \u0434\u043e\u043f\u043b\u0430\u0442\u043e\u044e.\n\n10 \u0434\u043d\u0456\u0432 \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nAI 0220 IB\n\u0422\u041e\u041f 13\nHyundai Sonata 2006\nV \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f \u2022 2.4i MT (161 \u043a.\u0441) \u2022 Base\n\n4\u00a0570 $\n\n4\u00a0300 $ \u00b7 182\u00a0492 \u0433\u0440\u043d\n344 \u0442\u0438\u0441. \u043a\u043c\n\u0410\u0432\u0442\u043e\u043c\u0430\u0442\n\u0413\u0430\u0437/\u0411\u0435\u043d\u0437\u0438\u043d, 2.36 \u043b\n\u041a\u0438\u0457\u0432\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u0422\u043e\u0440\u0433\n\n\ud83d\ude97 Hyundai Sonata 2006 \u2014 \u043d\u0430\u0434\u0456\u0439\u043d\u0456\u0441\u0442\u044c, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0430 \u0440\u043e\u043a\u0430\u043c\u0438! \u0428\u0443\u043a\u0430\u0454\u0448 \u0430\u0432\u0442\u043e, \u044f\u043a\u0435 \u043d\u0435 \u043f\u0456\u0434\u0432\u0435\u0434\u0435? \u0426\u0435 \u0441\u0430\u043c\u0435 \u0432\u043e\u043d\u0430! \u2705 \u041c\u043e\u0442\u043e\u0440 2.4 \u2014 \u0437\u0430\u043c\u0456\u043d\u0435\u043d\u0438\u0439 \u0440\u0456\u043a \u0442\u043e\u043c\u0443, \u043f\u0440\u0430\u0446\u044e\u0454 \u0442\u0438\u0445\u043e, \u043c\u0430\u0441\u043b\u0430 \u043d\u0435 \u0431\u0435\u0440\u0435. \u2705 \u041a\u043e\u0440\u043e\u0431\u043a\u0430 \u2014 \u0431\u0435\u0437 \u043f\u0456\u043d\u0430\u043d\u044c, \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0454 \u043f\u043b\u0430\u0432\u043d\u043e. \u2705 \u0425\u043e\u0434\u043e\u0432\u0430 \u2014 \u044f\u043a \u043d\u043e\u0432\u0430, \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0433\u0440\u0438\u043c\u0438\u0442\u044c. \u2705 \u0413\u0430\u0437/\u0431\u0435\u043d\u0437\u0438\u043d \u0432\u043f\u0438\u0441\u0430\u043d\u0438\u0439 \u0443 \u0442\u0435\u0445\u043f\u0430\u0441\u043f\u043e\u0440\u0442 \u2014 \u0435\u043a\u043e\u043d\u043e\u043c\u0456\u044f \u043d\u0430 \u043a\u043e\u0436\u043d\u0456\u0439 \u043f\u043e\u0457\u0437\u0434\u0446\u0456. \u0404 \u043f\u0438\u0442\u0430\u043d\u043d\u044f \u043f\u043e \u043f\u043e\u0440\u043e\u0433\u0430\u043c \u0442\u0430 \u0430\u0440\u043a\u0430\u043c \u0432\u0438\u0434\u043d\u043e \u043d\u0430 \u0432\u0456\u0434\u0435\u043e. \u0425\u043e\u0447\u0430 , \u043a\u0443\u0437\u043e\u0432 \u0443\u0436\u0435 \u0431\u0430\u0447\u0438\u0432 \u0436\u0438\u0442\u0442\u044f \u2014 \u0440\u043e\u043a\u0438 \u0431\u0435\u0440\u0443\u0442\u044c \u0441\u0432\u043e\u0454. \u0410\u043b\u0435 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0456 \u0446\u044f Sonata \u0436\u0438\u0432\u0430, \u043f\u043e\u0442\u0443\u0436\u043d\u0430 \u0439 \u043d\u0430\u0434\u0456\u0439\u043d\u0430, \u044f\u043a \u0443 \u0434\u0435\u043d\u044c \u043d\u0430\u0440\u043e\u0434\u0436\u0435\u043d\u043d\u044f. \ud83d\udcb0 \u0426\u0456\u043d\u0430 \u2014 4300$, \u0442\u043e\u0440\u0433 \u043c\u0456\u043d\u0456\u043c\u0430\u043b\u044c\u043d\u0438\u0439 \u0431\u0456\u043b\u044f \u043a\u0430\u043f\u043e\u0442\u0443. \u041f\u0440\u043e\u0431\u0456\u0433 \u2014 388 \u0442\u0438\u0441. \u043a\u043c, \u0430\u043b\u0435 \u0441\u0442\u0430\u043d \u0442\u0435\u0445\u043d\u0456\u043a\u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0441\u0430\u043c \u0437\u0430 \u0441\u0435\u0431\u0435. \ud83d\udc49 \u042f\u043a\u0449\u043e \u0448\u0443\u043a\u0430\u0454\u0448 \u0430\u0432\u0442\u043e, \u044f\u043a\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0438\u0442\u044c \u0432\u043a\u043b\u0430\u0434\u0435\u043d\u044c \u0456 \u0447\u0435\u0441\u043d\u043e \u0441\u043b\u0443\u0436\u0438\u0442\u0438\u043c\u0435 \u2014 \u0434\u0437\u0432\u043e\u043d\u0438 \u0442\u0430 \u043f\u0440\u0438\u0457\u0436\u0434\u0436\u0430\u0439. \u0422\u0430\u043a\u0456 \u0421\u043e\u043d\u0430\u0442\u0438 \u0434\u043e\u0432\u0433\u043e \u043d\u0435 \u0441\u0442\u043e\u044f\u0442\u044c!\n\n12 \u0434\u043d\u0456\u0432 \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nBE 9091 EH\n\u0422\u041e\u041f 13\n\u0422\u0456\u043b\u044c\u043a\u0438 \u043d\u0430 AUTO.RIA\nVolkswagen Golf 2001\nIV \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f/Typ 1J\n3\u00a0600 $ \u00b7 152\u00a0784 \u0433\u0440\u043d\n160 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0411\u0435\u043d\u0437\u0438\u043d, 1.39 \u043b\n\u041f\u0435\u0440\u0432\u043e\u043c\u0430\u0439\u0441\u044c\u043a (\u041c\u0438\u043a\u043e\u043b\u0430\u0457\u0432\u0441\u044c\u043a\u0430)\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u0422\u043e\u0440\u0433\n\n\u0410\u0432\u0442\u043e \u0432 \u0433\u0430\u0440\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456 , \u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0435 \u0430\u0432\u0442\u043e \u0437\u0430 \u044f\u043a\u0438\u043c \u0434\u043e\u0433\u043b\u044f\u0434\u0430\u0432, \u0432 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u0456 \u0437\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u043a\u043e\u043d\u0434\u0438\u0446\u0456\u043e\u043d\u0435\u0440 , \u043d\u043e\u0432\u0430 \u0440\u0435\u0437\u0438\u043d\u0430 , \u0432\u0441\u0435 \u0432 \u0433\u0430\u0440\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456 , \u0430\u0432\u0442\u043e \u043c\u0430\u0454 \u043d\u0435\u0437\u043d\u0430\u0447\u043d\u0456 \u0437\u043e\u0432\u043d\u0456\u0448\u043d\u0456 \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u043d\u0430 \u0444\u043e\u0442\u043e \u0432\u0441\u0435 \u0432\u0438\u0434\u043d\u043e , \u0432\u043d\u0443\u0442\u0440\u0456 \u0430\u0432\u0442\u043e \u0432 \u0434\u0443\u0436\u0435 \u0434\u0443\u0436\u0435 \u0433\u0430\u0440\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456 , \u0437\u0430\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043f\u0438\u0442\u0430\u043d\u043d\u044f \u0432 \u0434\u0456\u0440\u0435\u043a\u0442\n\n14 \u0434\u043d\u0456\u0432 \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nBM 3229 BT\n\u0422\u041e\u041f 13\n\u0422\u0456\u043b\u044c\u043a\u0438 \u043d\u0430 AUTO.RIA\nRenault Kangoo 2013\nII \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f\n4\u00a0800 $ \u00b7 203\u00a0712 \u0433\u0440\u043d\n140 \u0442\u0438\u0441. \u043a\u043c\n100 \u043a\u043c\n\u0415\u043b\u0435\u043a\u0442\u0440\u043e, 22 \u043a\u0412\u0442-\u0433\u043e\u0434\n\u041a\u0438\u0457\u0432\n\u0412\u043f\u0435\u0440\u0448\u0435 \u043d\u0430 AUTO.RIA\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u0422\u043e\u0440\u0433\n\u041e\u0431\u043c\u0456\u043d\n\n\u0412\u0441\u0435 \u043f\u0440\u0430\u0446\u044e\u0454 \u043c\u0430\u0448\u0438\u043d\u0430 \u0433\u0430\u0440\u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443\u0439\u0442\u0435\n\n18 \u0434\u043d\u0456\u0432 \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nBC 1134 II\n\u0422\u041e\u041f 13\nFord Focus 2006\nII \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f \u2022 1.6 Duratec MT (100 \u043a.\u0441.) \u2022 Base\n\n4\u00a0500 $\n\n4\u00a0400 $ \u00b7 186\u00a0736 \u0433\u0440\u043d\n293 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0413\u0430\u0437/\u0411\u0435\u043d\u0437\u0438\u043d, 1.6 \u043b\n\u041b\u044c\u0432\u0456\u0432 (\u041b\u044c\u0432\u0456\u0432\u0441\u044c\u043a\u0430)\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u041e\u0431\u043c\u0456\u043d\n\n2006\u0440.1.6 \u0431\u0435\u043d\u0437\u0438\u043d-\u0433\u0430\u0437(\u0432\u043f\u0438\u0441\u0430\u043d\u0438\u0439).\u0407\u0434\u0435 \u043d\u0430 \u0431\u0435\u043d\u0437\u0438\u043d\u0456 \u0456 \u043d\u0430 \u0433\u0430\u0437\u0443 \u0431\u0435\u0437 \u043f\u0440\u043e\u0431\u043b\u0435\u043c.\u041e\u0440\u0438\u0433\u0456\u043d\u0430\u043b\u044c\u043d\u0456 2 \u043a\u043b\u044e\u0447\u0456,\u0441\u0438\u0433\u043d\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f.\u0421\u0430\u043b\u043e\u043d \u044f\u043a \u0432 \u043d\u043e\u0432\u0456\u0439 \u043c\u0430\u0448\u0438\u043d\u0456+\u043e\u0434\u0456\u0442\u0456 \u0433\u0430\u0440\u043d\u0456 \u0444\u0456\u0440\u043c\u043e\u0432\u0456 \u0444\u043e\u0445\u043b\u0438.\u0410\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u043f\u0440\u043e\u0441\u0442\u0438\u0439,\u043d\u0430\u0434\u0456\u0439\u043d\u0438\u0439,\u0435\u043a\u043e\u043d\u043e\u043c\u043d\u0438\u0439 \u0442\u0430 \u0434\u0435\u0448\u0435\u0432\u0438\u0439 \u0432 \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u0456.\u041c\u043e\u0442\u043e\u0440,\u043a\u043e\u0440\u043e\u0431\u043a\u0430 \u0431\u0435\u0437 \u0437\u0430\u0443\u0432\u0430\u0436\u0435\u043d\u044c.\u0412\u0430\u0440\u0438\u0442\u0438,\u0444\u0430\u0440\u0431\u0443\u0432\u0430\u0442\u0438 \u043d\u0435 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e.\u0417\u0440\u043e\u0431\u043b\u0435\u043d\u043e \u0430\u043d\u0442\u0438\u043a\u043e\u0440\u043e\u0437\u0456\u0439\u043d\u0443 \u043e\u0431\u0440\u043e\u0431\u043a\u0443 \u0434\u043d\u0438\u0449\u0430.\u041a\u043e\u043d\u0434\u0438\u0446\u0456\u043e\u043d\u0435\u0440,\u0435\u043b\u0435\u043a\u0442\u0440\u0438\u043a\u0430,\u0432\u0441\u0435 \u0440\u043e\u0431\u043e\u0447\u0435.\u0413\u0435\u043d\u0440\u0456 \u0424\u043e\u0440\u0434 \u0432\u0436\u0435 \u043d\u0430 \u0434\u043e\u0431\u0440\u0438\u0445 \u0437\u0438\u043c\u043e\u0432\u0438\u0445 \u0448\u0438\u043d\u0430\u0445.\u0422\u0435\u0440\u043c\u0456\u043d\u043e\u0432\u0438\u0445 \u0432\u043a\u043b\u0430\u0434\u0456\u0432 \u043d\u0430 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456 \u043d\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0454.\u041f\u0456\u0447\u043a\u0430 \u0433\u0440\u0456\u0454,\u043a\u043e\u043b\u0435\u0441\u0430 \u043a\u0440\u0443\u0442\u044f\u0442\u044c\u0441\u044f,\u043c\u0443\u0437\u0438\u043a\u0430 \u0433\u0440\u0430\u0454,\u0444\u0430\u0440\u0438 \u0441\u0432\u0456\u0442\u044f\u0442\u044c.\u0421\u0456\u0434\u0430\u0442\u0438 \u0456 \u0457\u0445\u0430\u0442\u0438.\u0410\u0432\u0442\u043e \u0432\u0430\u0440\u0442\u0443\u0454 \u0441\u0432\u043e\u0457\u0445 \u0433\u0440\u043e\u0448\u0435\u0439.\u0422\u043e\u0440\u0433 \u043d\u0430 \u043c\u0456\u0441\u0446\u0456.\n\n24 \u0434\u043d\u0456 \u0442\u043e\u043c\u0443\nAA 9684 PB\n\u0422\u041e\u041f 12\nDaewoo Sens 2012\nI \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f (FL) \u2022 1.3 MT (70 \u043a.\u0441.)\n2\u00a0399 $ \u00b7 101\u00a0814 \u0433\u0440\u043d\n178 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u0443\u0447\u043d\u0430 / \u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\n\u0413\u0430\u0437/\u0411\u0435\u043d\u0437\u0438\u043d, 1.3 \u043b\n\u0411\u043e\u0440\u0438\u0441\u043f\u0456\u043b\u044c\n\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a\n\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043a\u0440\u0435\u0434\u0438\u0442\n\u0422\u043e\u0440\u0433\n\n\u041f\u0440\u043e\u0434\u0430\u043c Daewoo Sens SX \u0437 \u0433\u0430\u0437\u043e\u043c 4 \u043f\u043e\u043a\u043e\u043b\u0456\u043d\u043d\u044f(\u0432\u043f\u0438\u0441\u0430\u043d\u0438\u0439) \u0432 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0456\u0439 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u0430\u0446\u0456\u0457: \u0433\u0456\u0434\u0440\u043e\u043f\u0456\u0434\u0441\u0438\u043b\u044e\u0432\u0430\u0447 \u043a\u0435\u0440\u043c\u0430, \u043f\u0435\u0440\u0435\u0434\u043d\u0456 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u0441\u043a\u043b\u043e\u043f\u0456\u0434\u0439\u043e\u043c\u043d\u0438\u043a\u0438, \u043f\u0440\u0430\u0446\u044e\u044e\u0447\u0438\u0439 \u043a\u043e\u043d\u0434\u0438\u0446\u0456\u043e\u043d\u0435\u0440, 2012 \u0440\u043e\u043a\u0443 \u0432\u0438\u043f\u0443\u0441\u043a\u0443, \u0437 \u043f\u0440\u043e\u0431\u0456\u0433\u043e\u043c \u0432 178 \u0442\u0438\u0441. \u043a\u043c, \u0432 \u0440\u0456\u0434\u043d\u0456\u0439 \u0444\u0430\u0440\u0431\u0456, \u043e\u043a\u0440\u0456\u043c \u043a\u0430\u043f\u043e\u0442\u0430. \u041f\u043e \u043a\u0443\u0437\u043e\u0432\u0443 \u0432 \u0447\u0443\u0434\u043e\u0432\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456: \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u044f \u043a\u043e\u0440\u043e\u0437\u0456\u044f, \u00ab\u0440\u0438\u0436\u0438\u043a\u0438\u00bb, \u043c\u0430\u0454 \u043d\u0435\u0437\u043d\u0430\u0447\u043d\u0456 \u0441\u043b\u0456\u0434\u0438 \u0435\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0456\u0457. \u0412\u0441\u0435 \u0441\u043a\u043b\u043e \u0440\u0456\u0434\u043d\u0435(\u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0447\u0438 \u043b\u043e\u0431\u043e\u0432\u0435), \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044c \u043c\u0430\u0454 \u0433\u0430\u0440\u043d\u0435 \u0442\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f. \u0421\u0430\u043b\u043e\u043d \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0432 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456 - \u0447\u0438\u0441\u0442\u0456 \u0442\u0430 \u043e\u0445\u0430\u0439\u043d\u0456 \u0441\u0438\u0434\u0456\u043d\u043d\u044f, \u043d\u0435 \u043f\u043e\u0440\u0432\u0430\u0442\u0456, \u043d\u0435 \u043f\u0440\u043e\u0434\u0430\u0432\u043b\u0435\u043d\u0456, \u0431\u0435\u0437 \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u044c, \u043f\u043e\u043a\u0440\u0438\u0442\u0442\u044f \u043f\u0456\u0434\u043b\u043e\u0433\u0438 \u044f\u043a \u043d\u043e\u0432\u0435, \u0432\u0435\u0441\u044c \u043f\u043b\u0430\u0441\u0442\u0438\u043a \u0432 \u0447\u0443\u0434\u043e\u0432\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456, \u0441\u0442\u043e\u044f\u0442\u044c \u0454\u0432\u0440\u043e\u043a\u0430\u0440\u0442\u0438 \u0434\u0432\u0435\u0440\u0435\u0439, \u043f\u043e\u0442\u043e\u043b\u043e\u043a \u0447\u0438\u0441\u0442\u0435\u043d\u044c\u043a\u0438\u0439, \u0432 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u0456 \u043d\u0435 \u043f\u0430\u043b\u0438\u043b\u0438. \u041f\u043e \u0435\u043b\u0435\u043a\u0442\u0440\u0438\u0446\u0456 \u0432\u0441\u0435 \u043f\u0440\u0430\u0446\u044e\u0454 - \u0441\u0432\u0456\u0442\u043b\u043e, \u043f\u0456\u0447\u043a\u0430, \u043f\u0440\u0438\u043a\u0443\u0440\u044e\u0432\u0430\u0447, \u043e\u0441\u0432\u0456\u0442\u043b\u0435\u043d\u043d\u044f \u0441\u0430\u043b\u043e\u043d\u0443, \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u043e \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e \u0446\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u0438\u0439 \u0437\u0430\u043c\u043e\u043a \u0442\u0430 \u0434\u0432\u0443\u0445\u0441\u0442\u043e\u0440\u043e\u043d\u043d\u044f \u0441\u0438\u0433\u043d\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f \u0437 \u0434\u0432\u043e\u043c\u0430 \u043a\u043b\u044e\u0447\u0430\u043c\u0438 \u0442\u0430 \u0431\u0440\u0435\u043b\u043a\u0430\u043c\u0438, \u0454 CD \u043c\u0430\u0433\u043d\u0456\u0442\u043e\u043b\u0430 \u0437 USB. \u0414\u0432\u0438\u0433\u0443\u043d, \u0432 \u0441\u0438\u043b\u0443 \u0441\u0432\u043e\u0433\u043e \u043d\u0435\u0437\u043d\u0430\u0447\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0431\u0456\u0433\u0443, \u043f\u0440\u0430\u0446\u044e\u0454 \u0434\u043e\u0431\u0440\u0435, \u043d\u0435\u0449\u043e\u0434\u0430\u0432\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u043e \u0422\u041e \u0433\u0430\u0437\u043e\u0432\u043e\u0433\u043e \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f, \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e \u043d\u043e\u0432\u0438\u0439 \u0440\u0435\u0434\u0443\u043a\u0442\u043e\u0440. \u0425\u043e\u0434\u043e\u0432\u0430 \u0447\u0430\u0441\u0442\u0438\u043d\u0430 \u0434\u043e\u0431\u0440\u0430, \u0432 \u0447\u0443\u0434\u043e\u0432\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456, \u0431\u0435\u0437 \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0456\u0445 \u0441\u0442\u0443\u043a\u0456\u0432 \u0442\u0430 \u0448\u0443\u043c\u0456\u0432. \u041a\u043e\u0440\u043e\u0431\u043a\u0430 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0447 \u043f\u0440\u0430\u0446\u044e\u0454 \u0431\u0435\u0437 \u043d\u0430\u0440\u0456\u043a\u0430\u043d\u044c, \u043a\u0443\u043b\u0456\u0441\u0430 \u0432 \u043d\u043e\u0440\u043c\u0456, \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0456 \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u044e\u0442\u044c\u0441\u044f \u043f\u043b\u0430\u0432\u043d\u043e, \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0456 \u0448\u0443\u043c\u0438 \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456. \u0427\u0443\u0434\u043e\u0432\u0438\u0439 \u0432\u0430\u0440\u0456\u0430\u043d\u0442 \u0431\u044e\u0434\u0436\u0435\u0442\u043d\u043e\u0433\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0456\u043b\u044f \u0437 \u043c\u0456\u043d\u0456\u043c\u0430\u043b\u044c\u043d\u0438\u043c \u043d\u0430\u0431\u043e\u0440\u043e\u043c \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u0443 \u0437\u0430 \u0447\u0443\u0434\u043e\u0432\u0438\u0439 \u043f\u0440\u0430\u0439\u0441, \u043f\u0456\u0434\u0456\u0439\u0434\u0435 \u044f\u043a \u0434\u043b\u044f \u043d\u043e\u0432\u0430\u0447\u043a\u0430, \u0442\u0430\u043a \u0456 \u0434\u043b\u044f \u0449\u043e\u0434\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f. \u0417\u0438\u043c\u043e\u0432\u0430 \u0433\u0443\u043c\u0430. \u0427\u0443\u0434\u043e\u0432\u0435 \u0441\u0432\u0456\u0442\u043b\u043e(\u043d\u0430 \u043e\u0441\u0442\u0430\u043d\u043d\u044c\u043e\u043c\u0443 \u0444\u043e\u0442\u043e \u0431\u043b\u0438\u0436\u043d\u0454 \u0441\u0432\u0456\u0442\u043b\u043e \u0444\u0430\u0440) \u0404 \u043f\u0438\u0442\u0430\u043d\u043d\u044f - \u0437\u0430\u0434\u0430\u0432\u0430\u0439\u0442\u0435. \u0422\u0430\u043a\u043e\u0436 \u043c\u043e\u0436\u0443 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0431\u0443\u0434\u044c-\u044f\u043a\u0456 \u0444\u043e\u0442\u043e. \u041f\u043e \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043c \u043f\u043e\u0440\u044f\u0434\u043e\u043a, \u043f\u0440\u043e\u0434\u0430\u0436 \u0437 \u043f\u0435\u0440\u0435\u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044f\u043c \u043d\u0430 \u043d\u043e\u0432\u043e\u0433\u043e \u0432\u043b\u0430\u0441\u043d\u0438\u043a\u0430, \u0414\u0406\u042f, \u0434\u043e\u0440\u0443\u0447\u0435\u043d\u043d\u044f. \u041c\u043e\u0436\u043b\u0438\u0432\u0438\u0439 \u043f\u0440\u0438\u0433\u043e\u043d \u0432 \u0456\u043d\u0448\u0438\u0439 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u0439 \u043f\u0443\u043d\u043a\u0442 \u043f\u043e \u0434\u043e\u043c\u043e\u0432\u043b\u0435\u043d\u043e\u0441\u0442\u0456.\n\n7 \u0433\u043e\u0434\u0438\u043d \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nAP 4311 KA\n\u0422\u041e\u041f 12\nSmart Fortwo 2001\nC450\n2\u00a0600 $ \u00b7 110\u00a0344 \u0433\u0440\u043d\n236 \u0442\u0438\u0441. \u043a\u043c\n\u0420\u043e\u0431\u043e\u0442\n\u0411\u0435\u043d\u0437\u0438\u043d, 0.6 \u043b\n\u0417\u0430\u043f\u043e\u0440\u0456\u0436\u0436\u044f\n\n\u0410\u0432\u0442\u043e \u0432 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0440\u043e\u0431\u043e\u0447\u043e\u043c\u0443 \u0441\u0442\u0430\u043d\u0456.\u0417\u0430\u0434\u043d\u0456\u0439 \u0431\u0430\u043c\u043f\u0435\u0440 \u0437 \u043b\u0456\u0432\u0438\u043c \u0456 \u043f\u0440\u0430\u0432\u0438\u043c \u043a\u0440\u0438\u043b\u043e\u043c \u0430\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u043e\u0432\u0456 \u0456 \u043f\u043e\u0444\u0430\u0440\u0431\u043e\u0432\u0430\u043d\u0456 \u0432 \u0440\u0456\u0434\u043d\u0438\u0439 \u043a\u043e\u043b\u0456\u0440(15 \u0442\u0438\u0441.\u0433\u0440\u043d).\u041a\u043e\u043c\u0443 \u0446\u0456\u043a\u0430\u0432\u043e \u0437\u0430\u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443\u0439\u0442\u0435 \u0437\u0430 \u043d\u043e\u043c\u0435\u0440\u043e\u043c\n\n9 \u0433\u043e\u0434\u0438\u043d \u0442\u043e\u043c\u0443\n\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 VIN\nBC 8971 EI\n\u0422\u041e\u041f 12\n\u0422\u0456\u043b\u044c\u043a\u0438 \u