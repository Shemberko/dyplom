1e\u0420\u0418 \u0414\u0418\u0420\u0415\u041a\u0422\u041e\u0420\u0410 \u0406\u0412\u041c ...\n\n\u041d\u0430\u0443\u043a\u043e\u0432\u0456 \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u0457 \u0406\u0412\u041c \u041d\u0410\u0410\u041d\n\u041d\u0430\u0443\u043a\u043e\u0432\u0456 \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u0457 \u0406\u0412\u041c \u041d\u0410\u0410\u041d. 2019 \u00b7 2020 \u00b7 2021 \u00b7 2022 ...\n\n\u0406\u043d\u0448\u0456 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438 \u0437 \u0434\u043e\u043c\u0435\u043d\u0443 ivm.kiev.ua\u00a0\u00bb\n\u041e\u0433\u043b\u044f\u0434 \u0428\u0406\n\u041e\u0433\u043b\u044f\u0434 \u0432\u0456\u0434 \u0428\u0406\n+2\n\u00ab\u0406\u0412\u041c\u00bb \u2014 \u0446\u0435 \u0430\u0431\u0440\u0435\u0432\u0456\u0430\u0442\u0443\u0440\u0430, \u044f\u043a", "title": "\u0456\u0432\u043c - \u041f\u043e\u0448\u0443\u043a Google", "url": "https://www.google.com/search?q=%D1%96%D0%B2%D0%BC&oq=%D1%96%D0%B2%D0%BC&gs_lcrp=EgZjaHJvbWUqCggAEAAY4wIYgAQyCggAEAAY4wIYgAQyDQgBEC4YxwEY0QMYgAQyBwgCEC4YgAQyDQgDEC4YrwEYxwEYgAQyBwgEEAAYgAQyBwgFEAAYgAQyDggGEAAYChgLGLEDGIAEMhEIBxAuGAoYCxivARjHARiABDIOCAgQABgKGAsYsQMYgAQyCwgJEAAYChgLGIAE0gEHNjUyajBqN6gCCLACAfEFLleXP0TXRNzxBS5Xlz9E10Tc&sourceid=chrome&ie=UTF-8", "active": 114286, "totalOpen": 120004}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 35296, "totalOpen": 36960}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 120010, "totalOpen": 120010}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 119978, "totalOpen": 119978}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 120002, "totalOpen": 120002}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 119994, "totalOpen": 119994}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 120012, "totalOpen": 120012}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 120000, "totalOpen": 120000}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 120002, "totalOpen": 120002}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 0, "totalOpen": 120014}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 0, "totalOpen": 119978}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 0, "totalOpen": 120010}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 0, "totalOpen": 119990}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 0, "totalOpen": 119998}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 0, "totalOpen": 120020}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\n\n[Rails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 `ActiveRecord::Relation......", "tabId": "1903315533", "textSample": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432\n 1 \u0445\u0432. \u0447\u0438\u0442\u0430\u043d\u043d\u044f\nCodeguida \u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\n17 \u043b\u0438\u0441\u0442\u043e\u043f\u0430\u0434\u0430 2017\n \n 0  \u00b7  6 \u00b7  0 \u00b7 \n\u041d\u043e\u0432\u0438\u043d\u0438 / \u0420\u0435\u043b\u0456\u0437\u0438\n\nRailsInstaller 3.4.0 \u0434\u043b\u044f Windows\n\nKarafka (Ruby + Kafka) framework 1.1.0\n\nRails 5.1 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0432\u0441\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437 ActiveRecord::Relation#inspect\n\n\u0412\u0456\u0434\u0435\u043e\n\u0412\u0456\u0434\u0435\u043e \u0437 Keep Ruby Weird 2017\n\nDrifting Ruby\n\nGoRails\n\n\u0421\u0442\u0430\u0442\u0442\u0456\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, \u0442\u0432\u043e\u0440\u0435\u0446\u044c Ruby on Rails \u0442\u0430 CTO Basecamp\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f Vue.js \u0432 Rails\n\n\u041e\u0441\u043d\u043e\u0432\u0438 Faktory\n\nAtom: \u0442\u0440\u044e\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0442\u0430 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f Ruby \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n\u0406\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f Bootstrap \u0437 Rails 5\n\n\u042f\u043a \u0432\u043f\u0440\u043e\u0432\u0430\u0434\u0438\u0442\u0438 \u043d\u0430\u0431\u0456\u0440 \u043e\u0431\u0440\u043e\u0431\u043b\u044e\u0432\u0430\u0447\u0456\u0432 (worker pool)\n\n\u042f\u043a \u043d\u0430\u043c \u043e\u0431\u0434\u0443\u0440\u0438\u0442\u0438 Bundler \u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u0431\u0430\u0433\u0438\n\n5 \u043f\u043e\u0440\u0430\u0434 \u043f\u043e Ruby on Rails, \u044f\u043a\u0438\u0445 \u0432\u0438 \u043c\u043e\u0433\u043b\u0438 \u043d\u0435 \u0447\u0443\u043b\u0438\n\n\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f Proxy (\u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a) \u0432 Ruby\n\nDocker + Rails + \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0435\u0441\u0442\u0438 Headless Chrome\n\n\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0445 \u043a\u043b\u044e\u0447\u0456\u0432\n\n\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438 (advisory locks)\n\nPostgreSQL master-slave \u0440\u0435\u043f\u043b\u0456\u043a\u0430\u0446\u0456\u044f \u043d\u0430 Heroku \u0437 Rails\n\n\u042f\u043a \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u0438 \u0432\u0430\u0448\u0456 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0438 \u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 Waterfall gem\n\n\u041a\u043e\u0440\u0438\u0441\u043d\u043e\u0441\u0442\u0456\nSniffer \u2013 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0456\u0437\u0443 HTTP-\u0437\u0430\u043f\u0438\u0442\u0456\u0432\n\u0406\u043d\u0448\u0435\n\nRR 336: \u0420\u0435\u0444\u0430\u043a\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0442\u0430\u0440\u0438\u0445 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432 Rails Apps \u0437 Ben Orenstein\n\nAwesome Ruby \u2013 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043b\u0435\u043a\u0446\u0456\u044f Ruby \u0431\u0456\u0431\u043b\u0456\u043e\u0442\u0435\u043a, \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0456\u0432 \u0442\u0430 \u041f\u0417, \u0449\u043e \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u043e\u044e\n\n10 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043d\u0438\u0433 \u043f\u043e Ruby \u0443 2017\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 \u043a\u043d\u0438\u0436\u043e\u043a \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 Ruby on Rails \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\n\n15+ \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f Ruby on Rails\n\n\u041f\u0456\u0434\u0431\u0456\u0440\u043a\u0430 Ruby \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u044e \u0434\u043b\u044f Data Science\n\nror gem rspec ruby on rails \u0434\u0430\u0439\u0434\u0436\u0435\u0441\u0442 ruby activerecord\n\u041f\u043e\u043c\u0456\u0442\u0438\u043b\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0443? \u041f\u043e\u0432\u0456\u0434\u043e\u043c\u0442\u0435 \u0430\u0432\u0442\u043e\u0440\u0443, \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u0432\u0438\u0434\u0456\u043b\u0438\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u0437 \u043f\u043e\u043c\u0438\u043b\u043a\u043e\u044e \u0442\u0430 \u043d\u0430\u0442\u0438\u0441\u043d\u0443\u0442\u0438 Ctrl+Enter\n\u041f\u0456\u0434\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044c\nCodeguida  24\n\u041f\u0440\u0438\u0454\u0434\u043d\u0430\u0432\u0441\u044f: 2 \u0440\u043e\u043a\u0438 \u0442\u043e\u043c\u0443\n\u041a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456 (0)\n\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456\u0432\n\u0429\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u0443\u0432\u0430\u0442\u0438\u0441\u044f.\n\n \u0412\u0445\u0456\u0434\n\n\u0421\u0445\u043e\u0436\u0456 \u0441\u0442\u0430\u0442\u0442\u0456\n\u0414\u0432\u0430\u043d\u0430\u0434\u0446\u044f\u0442\u044c \u043f\u043e\u0440\u0430\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e \u0432\u0456\u0434 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u043e\u0433\u043e Rails \u043c\u0435\u043d\u0442\u043e\u0440\u0430\n\n\u0412 \u0446\u0456\u0439 \u0441\u0442\u0430\u0442\u0442\u0456 \u044f \u043f\u043e\u0434\u0456\u043b\u044e\u0441\u044f \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u0430\u043c\u0438, \u044f\u043a\u0456 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0456 \u0432 \u0440\u043e\u0431\u043e\u0442\u0456. \u0407\u0445...\n\n\u0421\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f API \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e Ruby on Rails \u0442\u0430 GraphQL\n\n\u041f\u0440\u043e\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f API-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0456\u0432 \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u0442\u0430 \u0432\u0435\u0431-\u0434\u043e\u0434\u0430\u0442\u043a\u0456\u0432 \u2013 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u043d\u0430...\n\n\u0429\u043e \u043f\u0438\u0442\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043f\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u0456 \u0443 \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 Ruby on Rails Developer\n\n\u0429\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u043b\u044e\u0434\u0438\u043d\u0430 \u044f\u043a\u0430 \u0448\u0443\u043a\u0430\u0454 \u0440\u043e\u0431\u043e\u0442\u0443? \u0417\u0432\u0438\u0447\u0430\u0439\u043d\u043e, \u0433\u0443\u0433\u043b\u0438\u0442\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u044f\u043a\u0456...\n\n\u0420\u043e\u0437\u043f\u043e\u0447\u043d\u0456\u043c\u043e \u0437 Rails 1: \u041f\u043e\u0440\u0430\u0434\u0438 \u0449\u043e\u0434\u043e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438 \u043f\u0456\u0434 Ruby/RoR\n\n\u0412\u0456\u0442\u0430\u044e, \u0434\u043e\u0440\u043e\u0433\u0438\u0439 \u0447\u0438\u0442\u0430\u0447. \u0420\u0430\u043d\u0456\u0448\u0435 \u044f \u0443 \u0432\u043a-\u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0456 Codeguida \u0430\u043d\u043e\u043d\u0441\u0443\u0432\u0430\u0432 \u0441\u0435\u0440\u0456\u044e \u0441\u0442\u0430\u0442\u0435\u0439 \u043f...\n\nRails: \u0428\u043b\u044f\u0445 \u0414\u0436\u0435\u0434\u0430\u044f\n\n\u041f\u0440\u0438\u0432\u0456\u0442, \u043f\u0430\u0434\u0430\u0432\u0430\u043d\u0438! \u0414\u043e\u043f\u043e\u043a\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043d\u0430\u0448 Cheffile, \u0432\u0435\u0440\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0447\u0438\u043a \u0442\u0430 \u043f\u0438\u0448\u0435\u0442\u044c...\n\n\u0422\u043e\u043f-10 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445 (\u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438)\n\n\u0429\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0434\u0435\u0441\u044f\u0442\u044c \u043d\u0430\u0439\u0440\u043e\u0437\u043f\u043e\u0432\u0441\u044e\u0434\u0436\u0435\u043d\u0456\u0448\u0438\u0445 \u043f\u043e\u043c\u0438\u043b\u043e\u043a \u0432 Ruby on Rails \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445, \u043a\u043e\u043c\u0430\u043d...\n\n\u0421\u0435\u0440\u0456\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u044f JSON \u0443 Rails: \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0435 \u043a\u0435\u0440\u0456\u0432\u043d\u0438\u0446\u0442\u0432\u043e\n\n\u0417 \u0442\u043e\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a JavaScript \u0441\u0442\u0430\u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0440\u043e\u0431\u043e\u0442\u0438 \u0432 \u0432\u0435\u0431\u0456, \u0441\u0435\u0440\u0456\u0430\u043b\u0456...\n\n\u042f\u043a \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 Ruby gem\n\n\u042f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0434\u0430\u0432\u043d\u043e \u0445\u043e\u0447\u0435\u0442\u0435 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u0433\u0435\u043c, \u0442\u043e \u0431\u0435\u0440\u0456\u0442\u044c\u0441\u044f \u0437\u0430 \u043c\u0438\u0448\u043a\u0443 \u0442\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0443, \u0441...", "title": "Ruby Digest #49: \u044f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 DHH, Vue.js \u0432 Rails, Atom \u0434\u043b\u044f \u0440\u0443\u0431\u0456\u0441\u0442\u0456\u0432 | DevZone", "url": "https://devzone.org.ua/post/ruby-digest-49-iak-pratsiuye-dhh-vuejs-v-rails-atom-dlia-rubistiv", "active": 0, "totalOpen": 119998}}]}
