7. \u041c\u0435\u0442\u0430\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u2014 \u0432\u0438\u0434 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f, \u043f\u043e\u0432'\u044f\u0437\u0430\u043d\u0438\u0439 \u0456\u0437 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f\u043c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043d\u043e\u0433\u043e \u043a\u043e\u0434\u0443, \u044f\u043a\u0438\u0439 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u043e\u043f\u0438\u0441\u0456\u0432 (\u043c\u0435\u0442\u0430\u0434\u0430\u043d\u0438\u0445) \u0434\u0435\u044f\u043a\u0438\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0456\u0432, \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0456\u0432 \u0430\u0431\u043e \u0434\u0430\u043d\u0438\u0445 \u043f\u043e\u0440\u043e\u0434\u0436\u0443\u0454 \u0456\u043d\u0448\u0456 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0456\u0457 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0456\u0432, \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u043e\u0441\u0442\u0435\u0439 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u0439 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0456\u0432 \u0430\u0431\u043e \u043e\u0431\u0440\u043e\u0431\u043a\u0438 \u0434\u0430\u043d\u0438\u0445[1]. \u041c\u0435\u0442\u0430\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u0435 \u043d\u0430 \u043c\u0435\u0442\u0430\u0434\u0430\u043d\u0438\u0445, \u044f\u043a\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0442\u0438 \u0442\u0438\u043f\u0438, \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u0430\u0431\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043e\u0431\u0440\u043e\u0431\u043a\u0438 \u0434\u0430\u043d\u0438\u0445, \u0430\u043b\u0435 \u043d\u0435 \u043e\u0431\u043c\u0435\u0436\u0443\u0454\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u0446\u0438\u043c. \u0413\u0435\u043d\u0435\u0440\u0443\u044e\u0447\u0456 \u043a\u043e\u0434 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0447\u0430\u0441\u0442\u043e \u043d\u0430\u0437\u0438\u0432\u0430\u044e\u0442\u044c \u043c\u0435\u0442\u0430\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430\u043c\u0438, a \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044f \u0446\u0438\u0445 \u043f\u0440\u043e\u0433\u0440\u0430\u043c \u043d\u0430\u0437\u0438\u0432\u0430\u0454\u0442\u044c\u0441\u044f \u043c\u0435\u0442\u0430\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f\u043c. \u0414\u0438\u0432. \u0442\u0430\u043a\u043e\u0436[\u0440\u0435\u0434. | \u0440\u0435\u0434. \u043a\u043e\u0434] \u0423\u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0435\u043d\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u041c\u0435\u0442\u0430\u043a\u043b\u0430\u0441 \u0421\u043a\u0430\u0444\u0444\u043e\u043b\u0434\u0438\u043d\u0433 \u041f\u0440\u0438\u043c\u0456\u0442\u043a\u0438[\u0440\u0435\u0434. | \u0440\u0435\u0434. \u043a\u043e\u0434] \u2191 \u0414\u0436\u043e\u043d\u0430\u0442\u0430\u043d \u0411\u0430\u0440\u0442\u043b\u0435\u0442\u0442. \u041c\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u043e \u043c\u0435\u0442\u0430\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f, \u0427\u0430\u0441\u0442\u0438\u043d\u0430 1: \u0412\u0441\u0442\u0443\u043f \u0434\u043e \u043c\u0435\u0442\u0430\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f [\u0410\u0440\u0445\u0456\u0432\u043e\u0432\u0430\u043d\u043e 24 \u0433\u0440\u0443\u0434\u043d\u044f 2013 \u0443 Wayback Machine.] (\u0440\u043e\u0441.) \u041f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f[\u0440\u0435\u0434. | \u0440\u0435\u0434. \u043a\u043e\u0434] \u041c\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u043e \u043c\u0435\u0442\u0430\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u0422\u0435\u043c\u0430\u0442\u0438\u0447\u043d\u0456 \u0441\u0430\u0439\u0442\u0438Quora \u00b7 Zhihu\u041d\u043e\u0440\u043c\u0430\u0442\u0438\u0432\u043d\u0438\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044cFreebase:\u00a0/m/022_fx \u0441\u0445\u043e\u0432\u0430\u0442\u0438\u043f\u043e\u0440\u041c\u0435\u0442\u0430-\u0414\u043e\u043c\u0435\u043d\u0438 \u0456 \u043c\u0435\u0442\u043e\u0434\u0438 \u041c\u0435\u0442\u0430\u0430\u043d\u0430\u043b\u0456\u0437 \u041c\u0435\u0442\u0430\u0431\u0456\u0431\u043b\u0456\u043e\u0433\u0440\u0430\u0444\u0456\u044f[en] \u041c\u0435\u0442\u0430\u0432\u0441\u0435\u0441\u0432\u0456\u0442 \u041c\u0435\u0442\u0430\u0433\u0435\u043d\u043e\u043c\u0456\u043a\u0430 \u041c\u0435\u0442\u0430\u0433\u0440\u0430 \u041c\u0435\u0442\u0430\u0434\u0430\u043d\u0456 \u041c\u0435\u0442\u0430\u0434\u0438\u0437\u0430\u0439\u043d[en] \u041c\u0435\u0442\u0430\u0434\u0438\u0441\u043a\u0443\u0440\u0441[en] \u041c\u0435\u0442\u0430\u0435\u0432\u0440\u0438\u0441\u0442\u0438\u043a\u0430 \u041c\u0435\u0442\u0430-\u0435\u043c\u043e\u0446\u0456\u044f \u041c\u0435\u0442\u0430\u043d\u0430\u0441\u0442\u0440\u0456\u0439[en] \u041c\u0435\u0442\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u041c\u0435\u0442\u0430\u0456\u0441\u0442\u043e\u0440\u0456\u044f \u041c\u0435\u0442\u0430\u043a\u043b\u0430\u0441[en] \u0421\u0435\u043c\u0430\u043d\u0442\u0438\u0447\u043d\u0430 \u043f\u0430\u0432\u0443\u0442\u0438\u043d\u0430[en] \u041c\u0435\u0442\u0430\u043a\u043e\u0433\u043d\u0456\u0446\u0456\u044f \u041c\u0435\u0442\u0430\u043d\u0430\u0432\u0447\u0430\u043d\u043d\u044f[en] \u041c\u0435\u0442\u0430\u043f\u0430\u043c'\u044f\u0442\u044c[en] \u041c\u0435\u0442\u0430\u043a\u043e\u043c\u043f'\u044e\u0442\u0438\u043d\u0433 \u041c\u0435\u0442\u0430\u043a\u043e\u043c\u0443\u043d\u0456\u043a\u0430\u0446\u0456\u044f[en] \u041c\u0435\u0442\u0430\u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0430 \u041c\u0435\u0442\u0430\u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b \u041c\u0435\u0442\u0430\u043c\u0435\u0434\u0456\u0430[en] \u041c\u0435\u0442\u0430\u043c\u0438\u0441\u0442\u0435\u0446\u0442\u0432\u043e \u041c\u0435\u0442\u0430\u043c\u043e\u0434\u0435\u043b\u044e\u0432\u0430\u043d\u043d\u044f[en] \u041c\u0435\u0442\u0430\u043c\u043e\u0434\u0435\u0440\u043d\u0456\u0437\u043c \u041c\u0435\u0442\u0430\u043c\u043e\u0432\u0430 \u041c\u0435\u0442\u0430\u043f\u0440\u0430\u0433\u043c\u0430\u0442\u0438\u043a\u0430[en] \u041c\u0435\u0442\u0430\u0441\u0435\u043c\u0430\u043d\u0442\u0438\u043a\u0430 \u041c\u0435\u0442\u0430\u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0456\u044f[en] \u041c\u0435\u0442\u0430\u043d\u0430\u0440\u0430\u0442\u0438\u0432 \u041c\u0435\u0442\u0430\u043d\u0430\u0443\u043a\u0430 \u041c\u0435\u0442\u0430\u043e\u0431'\u0454\u043a\u0442[en] \u041c\u0435\u0442\u0430-\u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f \u041c\u0435\u0442\u0430\u043e\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u0456\u044f[en] \u041c\u0435\u0442\u0430\u043f\u043e\u043b\u0456\u0442\u0438\u043a\u0430[en] \u041c\u0435\u0442\u0430\u043f\u043e\u043f\u0443\u043b\u044f\u0446\u0456\u044f \u041c\u0435\u0442\u0430\u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f[en] \u041c\u0435\u0442\u0430\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u041c\u0435\u0442\u0430\u043f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0456\u044f \u041c\u0435\u0442\u0430\u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u041c\u0435\u0442\u0430\u0442\u0435\u043e\u0440\u0435\u043c\u0430 \u041c\u0435\u0442\u0430\u0442\u0435\u043e\u0440\u0456\u044f \u041c\u0435\u0442\u0430\u0444\u0435\u043d\u043e\u043c\u0456\u043a\u0430[en] \u041c\u0435\u0442\u0430\u0444\u0456\u043b\u043e\u0441\u043e\u0444\u0456\u044f \u041c\u0435\u0442\u0430\u0435\u043f\u0456\u0441\u0442\u0435\u043c\u043e\u043b\u043e\u0433\u0456\u044f \u041c\u04