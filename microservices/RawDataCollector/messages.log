{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 3100, "totalOpen": 97112}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 118628, "totalOpen": 118628}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 120004, "totalOpen": 120004}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 119984, "totalOpen": 119984}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 120004, "totalOpen": 120004}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 119982, "totalOpen": 119982}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 120016, "totalOpen": 120016}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 119988, "totalOpen": 119988}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 119996, "totalOpen": 119996}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 90920, "totalOpen": 120002}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 0, "totalOpen": 119998}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "tabId": "1903321253", "textSample": "\u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436.", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 0, "totalOpen": 120014}}]}
{"user": {"info": {"email": "sasha.shemberko15@gmail.com", "id": "101776457075996230946"}}, "log": [{"info": {"metaDescription": "", "tabId": "1903321269", "textSample": "\u0412 \u0446\u044c\u043e\u043c\u0443 \u0432\u0438\u043f\u0430\u0434\u043a\u0443 \u043c\u0438 \u0432\u0437\u044f\u043b\u0438 \u043f\u043e\u0442\u0440\u043e\u0445\u0438 \u0437 \u043a\u043e\u0436\u043d\u043e\u0457 \u0441\u0435\u043a\u0446\u0456\u0457, \u0430 \u0441\u0442\u0440\u0456\u0447\u043a\u0438 <<<<<<<, ======= \u0442\u0430 >>>>>>> \u0432\u0438\u0434\u0430\u043b\u0438\u043b\u0438 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e. \u041f\u0456\u0441\u043b\u044f \u0442\u043e\u0433\u043e, \u044f\u043a \u0432\u0438 \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043b\u0438 \u043f\u043e\u0434\u0456\u0431\u043d\u0456 \u043d\u0435\u0441\u0443\u043c\u0456\u0441\u043d\u043e\u0441\u0442\u0456 \u0432 \u043a\u043e\u0436\u043d\u043e\u043c\u0443 \u0431\u043b\u043e\u0446\u0456 \u043a\u043e\u043d\u0444\u043b\u0456\u043a\u0442\u043d\u0438\u0445 \u0444\u0430\u0439\u043b\u0456\u0432, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0434\u043b\u044f \u043d\u0438\u0445 git add, \u0449\u043e\u0431 \u0456\u043d\u0434\u0435\u043a\u0441\u0443\u0432\u0430\u0442\u0438 \u0442\u0430 \u043f\u043e\u0437\u043d\u0430\u0447\u0438\u0442\u0438, \u044f\u043a \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u0456. \u0406\u043d\u0434\u0435\u043a\u0441\u0443\u044e\u0447\u0438 \u0444\u0430\u0439\u043b, \u0432\u0438 \u043f\u043e\u0437\u043d\u0430\u0447\u0430\u0454\u0442\u0435 \u0439\u043e\u0433\u043e \u0434\u043b\u044f Git \u0442\u0430\u043a\u0438\u043c, \u0449\u043e \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u043c\u0430\u0454 \u043a\u043e\u043d\u0444\u043b\u0456\u043a\u0442\u0443. \u042f\u043a\u0449\u043e \u0432\u0438 \u0445\u043e\u0447\u0435\u0442\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0438\u0439 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0434\u043b\u044f \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u043d\u044f \u043a\u043e\u043d\u0444\u043b\u0456\u043a\u0442\u0456\u0432, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u043a\u043e\u043c\u0430\u043d\u0434\u0443 git mergetool, \u044f\u043a\u0430 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0438\u0439 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u0442\u0430 \u043f\u0440\u043e\u0432\u0435\u0434\u0435 \u0432\u0430\u0441 \u043f\u043e \u0432\u0441\u044c\u043e\u043c\u0443 \u043f\u0440\u043e\u0446\u0435\u0441\u0443:", "title": "Git - \u041e\u0441\u043d\u043e\u0432\u0438 \u0433\u0430\u043b\u0443\u0436\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f", "url": "https://git-scm.com/book/uk/v2/%D0%93%D0%B0%D0%BB%D1%83%D0%B6%D0%B5%D0%BD%D0%BD%D1%8F-%D0%B2-git-%D0%9E%D1%81%D0%BD%D0%BE%D0%B2%D0%B8-%D0%B3%D0%B0%D0%BB%D1%83%D0%B6%D0%B5%D0%BD%D0%BD%D1%8F-%D1%82%D0%B0-%D0%B7%D0%BB%D0%B8%D0%B2%D0%B0%D0%BD%D0%BD%D1%8F", "active": 156, "totalOpen": 156}}]}
