7 \u0421\u0443\u043f\u0440\u043e\u0432\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0442\u0430 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445 10.8 \u0417\u043c\u0456\u043d\u043d\u0456 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 10.9 \u041f\u0456\u0434\u0441\u0443\u043c\u043e\u043a A1. \u0414\u043e\u0434\u0430\u0442\u043e\u043a A: Git \u0432 \u0456\u043d\u0448\u0438\u0445 \u0441\u0435\u0440\u0435\u0434\u043e\u0432", "title": "Git - \u041e\u0441\u043d\u043e\u0432\u0438 \u0433\u0430\u043b\u0443\u0436\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u043b\u0438\u0432\u0430\u043d\u043d\u044f", "url": "https://git-scm.com/book/uk/v2/%D0%93%D0%B0%D0%BB%D1%83%D0%B6%D0%B5%D0%BD%D0%BD%D1%8F-%D0%B2-git-%D0%9E%D1%81%D0%BD%D0%BE%D0%B2%D0%B8-%D0%B3%D0%B0%D0%BB%D1%83%D0%B6%D0%B5%D0%BD%D0%BD%D1%8F-%D1%82%D0%B0-%D0%B7%D0%BB%D0%B8%D0%B2%D0%B0%D0%BD%D0%BD%D1%8F", "active": 576, "totalOpen": 60018}}, {"info": {"metaDescription": "\u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u043d\u0430 \u0421++ \u0437 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 clock. \u041a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++ \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u043e\u044e.\n", "previewImage": "https://zaxid.net/resources/photos/news/450_DIR/201403/1304629.jpg", "tabId": 1903387440, "textSample": "\u0413\u043e\u043b\u043e\u0432\u043d\u0435 \u043c\u0435\u043d\u044e \u0413\u043e\u043b\u043e\u0432\u043d\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0430 \u041f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f - \u041e\u0441\u043d\u043e\u0432\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f - Assembler - Delphi - \u041f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u0456\u043a\u0440\u043e\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0456\u0432 - C - C++ - C# - Java - Python Web-\u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f - HTML - CSS - PHP \u0406\u043d\u0448\u0438\u0439 \u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b - Internet - Ucoz - \u0417\u0430\u043b\u0456\u0437\u043e - Photoshop - Flash - \u041a\u043e\u043c\u043f'\u044e\u0442\u0435\u0440\u043d\u0430 \u0433\u0440\u0430\u0444\u0456\u043a\u0430 - 3D \u0433\u0440\u0430\u0444\u0456\u043a\u0430 - \u0420\u0456\u0437\u043d\u0435 - \u041e\u0433\u043e\u043b\u043e\u0448\u0435\u043d\u043d\u044f \u0414\u043e\u043f\u043e\u043c\u043e\u0433\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0443 \u0414\u0440\u0443\u0437\u0456 \u041f\u0440\u043e \u043d\u0430\u0441 \u041d\u0430\u0448\u0430 \u043a\u043d\u043e\u043f\u043a\u0430 <a href=\"http://programming.in.ua/\" target=\"_blank\"> <img src=\"http://programming.in.ua/images/stories/baner.gif\" border=\"0\" alt=\"\u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0456 \u0443\u0440\u043e\u043a\u0438 \u043f\u0440\u043e \u0406\u0422\" title=\"\u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0456 \u0443\u0440\u043e\u043a\u0438 \u043f\u0440\u043e \u0406\u0422\" /> </a> \u0414\u0440\u0443\u0437\u0456 \u0413\u043e\u043b\u043e\u0432\u043d\u0430 \u041f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f - C++ \u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u041d\u0430\u043f\u0438\u0441\u0430\u0432 Joker \u0412\u0456\u0432\u0442\u043e\u0440\u043e\u043a, 24 \u0442\u0440\u0430\u0432\u043d\u044f 2016 22:39 \u041f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0456\u0432: 6930 - 4\u0445\u0432\u0438\u043b\u0438\u043d\u0438 \u0437\u0430 \u0447\u0430\u0448\u043a\u0443 \u043a\u0430\u0432\u0438!? \u0412\u0447\u043e\u0440\u0430 \u0446\u0435 \u043a\u043e\u0448\u0442\u0443\u0432\u0430\u043b\u043e 3! - \u0412\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u043a\u0430\u0432\u0430 \u0447\u0438 \u0441\u043f\u043e\u0433\u0430\u0434\u0438? \u00a9 \u0444\u0456\u043b\u044c\u043c \u00abTime\u00bb \u041f\u0456\u0434 \u0447\u0430\u0441 \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043e\u0434\u043d\u0438\u043c \u0456\u0437 \u0434\u0443\u0436\u0435 \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u0445 \u0447\u0438\u043d\u043d\u0438\u043a\u0456\u0432 \u0454 \u0447\u0430\u0441 \u0440\u043e\u0431\u043e\u0442\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438, \u0457\u0457 \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u044f. \u0426\u0435 \u0432\u0430\u0436\u043b\u0438\u0432\u043e \u0456 \u0443 \u0456\u043d\u0448\u0438\u0445 \u0432\u0438\u043f\u0430\u0434\u043a\u0430\u0445. \u042f\u043a\u0449\u043e \u0432\u0430\u0448\u0430 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430 \u043f\u043e\u0432\u0456\u043b\u044c\u043d\u0430 \u0447\u0438 \u043f\u0440\u0430\u0446\u044e\u0454 \u043d\u0435 \u0440\u0430\u0446\u0456\u043e\u043d\u0430\u043b\u044c\u043d\u043e, \u0442\u043e \u0457\u0457 \u043a\u043e\u0440\u0438\u0441\u043d\u0456\u0441\u0442\u044c \u0440\u0456\u0437\u043a\u043e \u043f\u0430\u0434\u0430\u0454. \u042f\u043a\u0449\u043e \u0443\u044f\u0432\u0438\u0442\u0438, \u0449\u043e \u043c\u0438 \u043d\u0430\u0432\u0447\u0438\u043c\u043e \u044f\u043a\u0443\u0441\u044c \u043c\u0430\u0432\u043f\u0443 \u043f\u0438\u0441\u0430\u0442\u0438 \u043b\u0456\u0442\u0435\u0440\u0438 \u043d\u0456\u043c\u0435\u0446\u044c\u043a\u043e\u0433\u043e \u0430\u043b\u0444\u0430\u0432\u0456\u0442\u0443 \u0456 \u0446\u044f \u043c\u0430\u0432\u043f\u0430 \u0431\u0443\u0434\u0435 \u0432\u0456\u0447\u043d\u043e \u0436\u0438\u0442\u0438 \u0456 \u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0438\u0441\u0430\u0442\u0438 (\u0432\u043e\u043d\u0430 \u0431\u0443\u0434\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u0430 \u043f\u0430\u043f\u0435\u0440\u043e\u043c). \u0422\u043e \u0442\u0430\u043a\u0438\u043c \u0447\u0438\u043d\u043e\u043c, \u043a\u043e\u043b\u0438\u0441\u044c \u0443 \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u044c\u043e\u043c\u0443 \u0432\u043e\u043d\u0430 \u043c\u043e\u0436\u0435 \u0441\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u0438 \u0440\u043e\u043c\u0430\u043d \u0415.\u041c. \u0420\u0435\u043c\u0430\u0440\u043a\u0430 \u00ab\u0422\u0440\u0456\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u0430\u0440\u043a\u0430\u00bb. \u0426\u0435 \u0436 \u043f\u043e-\u0441\u0443\u0442\u0456 \u0442\u0435\u0436 \u043c\u043e\u0436\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0442\u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u041c\u0430\u0432\u043f\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043b\u0430 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443, \u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e\u0447\u0438 \u0446\u044c\u043e\u0433\u043e. \u0410\u043b\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u043d\u0435\u0446\u0456\u043d\u044e\u0454 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442. \u0426\u0435 \u0437\u0432\u0456\u0441\u043d\u043e \u0434\u0435\u0449\u043e \u043f\u0435\u0440\u0435\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0438\u0439 \u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0430\u043b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u0442\u0430\u043a\u0430 \u0436. \u041e\u0442\u0436\u0435, \u0432\u0441\u0435 \u043f\u043e\u0432\u0438\u043d\u043d\u043e \u0431\u0443\u0442\u0438 \u0448\u0432\u0438\u0434\u043a\u043e. \u0423 \u0441\u043f\u043e\u0440\u0442\u0438\u0432\u043d\u043e\u043c\u0443 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u0456 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c \u0442\u0430\u043a\u0435 \u043f\u043e\u043d\u044f\u0442\u0442\u044f \u044f\u043a \u00ab\u043e\u0431\u0447\u0438\u0441\u043b\u044e\u0432\u0430\u043b\u044c\u043d\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c\u00bb. \u0410\u043b\u0435 \u0441\u043f\u0435\u0440\u0448\u0443 \u0432\u0430\u0440\u0442\u043e \u0432\u043c\u0456\u0442\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0442\u0438 \u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0447\u0430\u0441\u0443 \u043f\u0440\u0430\u0446\u044e\u0454 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0430. \u0414\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0437\u043d\u0430\u0434\u043e\u0431\u0438\u0442\u044c\u0441\u044f \u0441\u0435\u043a\u0443\u043d\u0434\u043e\u043c\u0456\u0440. \u0412\u0441\u0435 \u044f\u043a \u0443 \u0436\u0438\u0442\u0442\u0456. \u0412\u0456\u0437\u044c\u043c\u0435\u043c\u043e \u0441\u043f\u043e\u0440\u0442\u0441\u043c\u0435\u043d\u0430, \u044f\u043a\u0438\u0439 \u043f\u043e\u0432\u0438\u043d\u0435\u043d \u043f\u0440\u043e\u0431\u0456\u0433\u0442\u0438 \u043e\u0434\u043d\u0435 \u043a\u043e\u043b\u043e \u043d\u0430\u0432\u043a\u043e\u043b\u043e \u0441\u0442\u0430\u0434\u0456\u043e\u043d\u0443. \u041f\u0456\u0441\u043b\u044f \u043a\u043e\u043c\u0430\u043d\u0434\u0438 \u00ab\u0421\u0422\u0410\u0420\u0422\u00bb \u0432\u043c\u0438\u043a\u0430\u0454\u043c\u043e \u0441\u0435\u043a\u0443\u043d\u0434\u043e\u043c\u0456\u0440 \u0456 \u043a\u043e\u043b\u0438 \u0432\u0456\u043d \u043f\u0435\u0440\u0435\u0442\u043d\u0435 \u0444\u0456\u043d\u0456\u0448\u043d\u0443 \u043f\u0440\u044f\u043c\u0443 \u043c\u0438 \u0437\u0443\u043f\u0438\u043d\u044f\u0454\u043c\u043e \u0432\u0456\u0434\u043b\u0456\u043a \u0447\u0430\u0441\u0443. ", "title": "\u0411\u0430\u0437\u043e\u0432\u0438\u0439 \u043a\u0443\u0440\u0441 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0421++. \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0434\u0456\u0457 (\u0447\u0430\u0441\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f) \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 - \u0423\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443\u0432\u0430\u043d\u043d\u044f", "url": "https://programming.in.ua/programming/c-plus-plus/323-time-to-program-run-c-plus-plus.html", "active": 625, "totalOpen": 58284}}, {"info": {"metaDescription": "\u041f\u0410\u0411\u0413 \u0437\u0456 \u0441\u0442\u0440\u0456\u043c\u0435\u0440\u0430\u043c\u0438 - \u0421\u043a\u0435\u0432\u0456\u0447, \u041b\u0443\u043c\u0430, \u0420\u0443\u043b\u044f, \u0406\u0432\u043e\u043d\u044f\u043a\u25cb \u0417 \u043a\u0438\u043c \u0433\u0440\u0430\u0432:\u0420\u0443\u043b\u044f - https://www.twitch.tv/roolex9\u041b\u0443\u043c\u0430 - https://www.twitch.tv/luma_rum\u0406\u0432\u043e\u043d\u044f\u043a - https://www.twi...", "previewImage": "https://i.ytimg.com/vi/lIESXBd7hE8/maxresdefault.jpg", "tabId": 1903387447, "textSample": "\u041b\u0415\u0413\u0415\u041d\u0414\u0418 \u041f\u041e\u0412\u0415\u0420\u0422\u0410\u042e\u0422\u042c\u0421\u042f! - PUBG \u0437 \u0420\u0443\u043b\u0435\u044e, \u041b\u0443\u043c\u043e\u044e \u0442\u0430 \u0406\u0432\u043e\u043d\u044f\u043a\u043e\u043c\u0423\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c \u0437\u0432\u0443\u043a2x\u0428\u0443\u043a\u0430\u0442\u0438\u0406\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f\u041f\u043e\u043a\u0443\u043f\u043a\u0438\u042f\u043a\u0449\u043e \u0432\u0456\u0434\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u043d\u0435\u0437\u0430\u0431\u0430\u0440\u043e\u043c \u043d\u0435 \u043f\u043e\u0447\u043d\u0435\u0442\u044c\u0441\u044f, \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0456\u0442\u044c \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439.\u2022\u041d\u0430\u0441\u0442\u0443\u043f\u043d\u0435\u0423 \u043f\u0440\u044f\u043c\u043e\u043c\u0443 \u0435\u0444\u0456\u0440\u0456\u041d\u0435\u0437\u0430\u0431\u0430\u0440\u043e\u043c\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438\u0412\u0456\u0434\u0442\u0432\u043e\u0440\u0438\u0442\u0438\u0412\u0438 \u0432\u0438\u0439\u0448\u043b\u0438 \u0437 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443\u0412\u0456\u0434\u0435\u043e, \u044f\u043a\u0456 \u0432\u0438 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0430\u0454\u0442\u0435, \u043c\u043e\u0436\u0443\u0442\u044c \u0434\u043e\u0434\u0430\u0432\u0430\u0442\u0438\u0441\u044f \u0432 \u0456\u0441\u0442\u043e\u0440\u0456\u044e \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0456\u0432 \u043d\u0430 \u0442\u0435\u043b\u0435\u0432\u0456\u0437\u043e\u0440\u0456 \u0439 \u0432\u043f\u043b\u0438\u0432\u0430\u0442\u0438 \u043d\u0430 \u0432\u0430\u0448\u0456 \u043f\u043e\u0434\u0430\u043b\u044c\u0448\u0456 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0456\u0457. \u0429\u043e\u0431 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438 \u0446\u044c\u043e\u0433\u043e, \u0441\u043a\u0430\u0441\u0443\u0439\u0442\u0435 \u0434\u0456\u044e \u0442\u0430 \u0432\u0432\u0456\u0439\u0434\u0456\u0442\u044c \u043d\u0430 YouTube \u043d\u0430 \u043a\u043e\u043c\u043f\u2019\u044e\u0442\u0435\u0440\u0456.\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438\u041f\u043e\u0434\u0456\u043b\u0438\u0442\u0438\u0441\u044f\u0414\u043e\u043b\u0443\u0447\u0438\u0442\u0438 \u0441\u043f\u0438\u0441\u043e\u043a \u0432\u0456\u0434\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f\u041f\u0456\u0434 \u0447\u0430\u0441 \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0457 \u043f\u0440\u043e \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043f\u043e\u043c\u0438\u043b\u043a\u0430. \u041f\u043e\u0432\u0442\u043e\u0440\u0456\u0442\u044c \u0441\u043f\u0440\u043e\u0431\u0443 \u043f\u0456\u0437\u043d\u0456\u0448\u0435.0:00 / 19:51\u0423 \u043f\u0440\u044f\u043c\u043e\u043c\u0443 \u0435\u0444\u0456\u0440\u0456\u2022\u041f\u043e\u0432\u043d\u0430 \u0432\u0435\u0440\u0441\u0456\u044f \u0432\u0456\u0434\u0435\u043e\u041f\u0440\u043e \u0440\u043e\u0437\u0434\u0456\u043b\u0414\u043b\u044f \u043f\u0440\u0435\u0441\u0438\u0410\u0432\u0442\u043e\u0440\u0441\u044c\u043a\u0456 \u043f\u0440\u0430\u0432\u0430\u0417\u0432'\u044f\u0437\u0430\u0442\u0438\u0441\u044f \u0437 \u043d\u0430\u043c\u0438\u0414\u043b\u044f \u0430\u0432\u0442\u043e\u0440\u0456\u0432\u0414\u043b\u044f \u0440\u0435\u043a\u043b\u0430\u043c\u043e\u0434\u0430\u0432\u0446\u0456\u0432\u0414\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0456\u0432\u0423\u043c\u043e\u0432\u0438\u041a\u043e\u043d\u0444\u0456\u0434\u0435\u043d\u0446\u0456\u0439\u043d\u0456\u0441\u0442\u044c\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u0439 \u0431\u0435\u0437\u043f\u0435\u043a\u0430\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 YouTube\u0421\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0442\u0438 \u043d\u043e\u0432\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457\u00a9 2026 Google LLC\u0412\u0438\u043c\u043a\u043d\u0443\u0442\u0438", "title": "\u041b\u0415\u0413\u0415\u041d\u0414\u0418 \u041f\u041e\u0412\u0415\u0420\u0422\u0410\u042e\u0422\u042c\u0421\u042f! - PUBG \u0437 \u0420\u0443\u043b\u0435\u044e, \u041b\u0443\u043c\u043e\u044e \u0442\u0430 \u0406\u0432\u043e\u043d\u044f\u043a\u043e\u043c - YouTube", "url": "https://www.youtube.com/watch?v=lIESXBd7hE8", "active": 2196, "totalOpen": 51967}}, {"info": {"metaDescription": "", "previewImage": "https://maps.google.com/maps/api/staticmap?center=49.840128%2C24.0222208&zoom=13&size=900x900&language=en&sensor=false&key=AIzaSyBoYjeRtfVI0Jd8Q_9mnflo9i4sOYpShB0&signature=U2eplYU5IWLQqaKy2hGfX9q2wFU", "tabId": 1903387452, "textSample": "\u041f\u0435\u0440\u0435\u0442\u044f\u0433\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0437\u043c\u0456\u043d\u0438\u0442\u0438\u041f\u0435\u0440\u0435\u0442\u044f\u0433\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0437\u043c\u0456\u043d\u0438\u0442\u0438; \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438\u0428\u0443\u043a\u0430\u0442\u0438 \u043d\u0430 \u041a\u0430\u0440\u0442\u0430\u0445 Google\ue8f9\u0420\u043e\u0431\u043e\u0442\u0430 \u0423\u043a\u0430\u0437\u0430\u0442\u0438 \u043c\u0456\u0441\u0446\u0435\ue8b5\u0413\u0443\u0440\u0442\u043e\u0436\u0438\u0442\u043e\u043a \u211618 \u041d\u0423\"\u041b\u041f\" \u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e \u0432 \u0441\u043f\u0438\u0441\u043a\u0443 \"\u0412\u0438\u0431\u0440\u0430\u043d\u0435\"\ue8b5\u043a\u0430\u0440\u0442\u0430 \ue8b5\u0424\u043e\u0440\u0443\u043c \u041b\u044c\u0432\u0456\u0432 \u0432\u0443\u043b\u0438\u0446\u044f \u041f\u0456\u0434 \u0414\u0443\u0431\u043e\u043c, \u041b\u044c\u0432\u0456\u0432, \u041b\u044c\u0432\u0456\u0432\u0441\u044c\u043a\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u0412\u0456\u0434\u0447\u0438\u043d\u0435\u043d\u043e \u00b7 \u0417\u0430\u0447\u0438\u043d\u044f\u0454\u0442\u044c\u0441\u044f \u043e 21:00\ue8b5\u041b\u044c\u0432\u0456\u0432 \u0413\u043e\u043b\u043e\u0432\u043d\u0438\u0439 \u0417\u0430\u043b\u0456\u0437\u043d\u0438\u0447\u043d\u0438\u0439 \u0412\u043e\u043a\u0437\u0430\u043b, \u0432\u0443\u043b\u0438\u0446\u044f \u0413\u043e\u0440\u043e\u0434\u043e\u0446\u044c\u043a\u0430, \u041b\u044c\u0432\u0456\u0432, \u041b\u044c\u0432\u0456\u0432\u0441\u044c\u043a\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u044c\u0411\u0456\u043b\u044c\u0448\u0435 \u0437 \u0456\u0441\u0442\u043e\u0440\u0456\u0457 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0445 \u043f\u043e\u0448\u0443\u043a\u0456\u0432 \u041b\u044c\u0432\u0456\u0432-3\u00b0\u041d\u0435\u0456\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u0438\u0439 \u0442\u0440\u0430\u0444\u0456\u043a \u0443 \u0440\u0430\u0439\u043e\u043d\u0456\u0417\u0432\u0438\u0447\u0430\u0439\u043d\u0456 \u0443\u043c\u043e\u0432\u0438 \u0456\u0437 \u0437\u0430\u0442\u0440\u0438\u043c\u043a\u0430\u043c\u0438 \u0434\u043e 8 \u0445\u0432\u0420\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0438\u0413\u043e\u0442\u0435\u043b\u0456\u0427\u0438\u043c \u0437\u0430\u0439\u043d\u044f\u0442\u0438\u0441\u044f\u041c\u0443\u0437\u0435\u0457\u0422\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0410\u043f\u0442\u0435\u043a\u0438\u0411\u0430\u043d\u043a\u043e\u043c\u0430\u0442\u0438\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e\u041d\u0435\u0449\u043e\u0434\u0430\u0432\u043d\u04563\u041b\u044c\u0432\u0456\u0432\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0434\u043e\u0434\u0430\u0442\u043e\u043a\u041d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u0438 \u0432\u0430\u0448\u0435 \u043c\u0456\u0441\u0446\u0435\u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0414\u043e\u043a\u043b\u0430\u0434