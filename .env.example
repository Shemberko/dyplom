# Copy to .env and change the secrets:  cp .env.example .env
# Local Neo4j started by docker compose (password: min. 8 characters)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# Secret for signing JWT tokens in RecommendationsReader
JWT_SECRET_KEY=change-me-to-a-long-random-string
